<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Appoinly CRM — Outlook add-in manifest (taskpane / message-read sidebar).

  Sideload / install: point Outlook at the hosted URL of THIS file:
    https://www.appoinlycrm.net/outlook-manifest.xml

  Icons: only SVG assets exist in apps/web/public (icon-192.svg / icon-512.svg).
  Office icon elements require PNG, so we reference hosted PNG variants via
  absolute HTTPS URLs on the app domain. (The SVG source files that back these
  are apps/web/public/icon-192.svg and icon-512.svg.)
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Fixed, stable add-in identity. -->
  <Id>b7f3a2c1-9d4e-4c88-a1f2-6e0d5b3c7a91</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>AppoinlyCRM</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Appoinly CRM" />
  <Description DefaultValue="See CRM context for the sender of the open email, log the email, and create a lead — without leaving Outlook." />
  <IconUrl DefaultValue="https://www.appoinlycrm.net/icon-192.svg" />
  <HighResolutionIconUrl DefaultValue="https://www.appoinlycrm.net/icon-512.svg" />
  <SupportUrl DefaultValue="https://www.appoinlycrm.net/settings/email-integration" />

  <!-- Only mail hosts. -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <!-- Minimum requirement for a message-read taskpane. -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- Legacy (non-add-in-commands clients) fallback: taskpane on read. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://www.appoinlycrm.net/addin/outlook/taskpane" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Read the current message (sender, subject). -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <!-- Modern add-in commands: a ribbon button on the read surface. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- No standalone function file needed — the button only opens a taskpane. -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="apCrmGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="apCrmOpenTaskpane">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://www.appoinlycrm.net/icon-192.svg" />
        <bt:Image id="icon32" DefaultValue="https://www.appoinlycrm.net/icon-192.svg" />
        <bt:Image id="icon80" DefaultValue="https://www.appoinlycrm.net/icon-512.svg" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://www.appoinlycrm.net/addin/outlook/taskpane" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Appoinly CRM" />
        <bt:String id="btnLabel" DefaultValue="CRM" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnTip" DefaultValue="Open the Appoinly CRM sidebar for this email's sender." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
