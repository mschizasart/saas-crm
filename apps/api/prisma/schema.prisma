model TicketReply {
  id          String   @id @default(uuid())
  ticketId    String
  userId      String?  // staff or contact user id
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@map("ticket_replies")
}

model TicketAttachment {
  id          String   @id @default(uuid())
  ticketId    String
  replyId     String?
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reply       TicketReply? @relation(fields: [replyId], references: [id])

  @@map("ticket_attachments")
}

model TicketSpamFilter {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // Field to inspect: "subject" | "fromEmail" | "body" | "fromDomain"
  field          String
  // Match operator: "contains" | "equals" | "startsWith" | "endsWith" | "regex"
  operator       String
  pattern        String
  caseSensitive  Boolean  @default(false)
  // Action on match: "mark_spam" | "auto_close" | "reject"
  action         String
  isActive       Boolean  @default(true)
  // Lower priority is checked first; first match wins.
  priority       Int      @default(0)
  // Telemetry: how many inbound mails this rule caught.
  matchCount     Int      @default(0)
  lastMatchedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isActive, priority])
  @@map("ticket_spam_filters")
}

// ═══════════════════════════════════════════════════════════════
//  CONTRACTS
// ═══════════════════════════════════════════════════════════════

model ContractType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts      Contract[]

  @@index([organizationId])
  @@map("contract_types")
}

model Contract {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  typeId         String?
  subject        String
  value          Decimal? @db.Decimal(15, 2)
  description    String?
  // Free-form content (HTML/markdown body) separate from description
  content        String?
  // Free-form type label; independent of the typeId FK to ContractType
  type           String?
  // Lifecycle state: draft | sent | pending_signature | active | expired | cancelled
  status         String   @default("draft")
  createdBy      String?
  startDate      DateTime?
  endDate        DateTime?
  signed         Boolean  @default(false)
  signature      String?  // base64
  // Newer signing flow (extended signer metadata)
  signatureData  String?
  signedByName   String?
  signedByEmail  String?
  signedAt       DateTime?
  signedName     String?
  signedIp       String?
  noticeType     Int?     // days before end to notify
  hash           String   @unique @default(uuid())
  // E-signature toggle — when true, the public view requires a drawn signature
  // (creates a Signature row with audit trail). Otherwise the legacy
  // click-to-accept/sign-with-data flow is used.
  signatureRequired Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?       @relation(fields: [clientId], references: [id])
  contractType   ContractType? @relation(fields: [typeId], references: [id])
  comments       ContractComment[]
  customFieldValues CustomFieldValue[]

  @@index([organizationId])
  @@map("contracts")
}

model ContractComment {
  id         String   @id @default(uuid())
  contractId String
  userId     String?
  content    String
  createdAt  DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_comments")
}

// ═══════════════════════════════════════════════════════════════
//  E-SIGNATURES (polymorphic — proposal | contract)
// ═══════════════════════════════════════════════════════════════
//
// One row per signing event. Polymorphic on (documentType, documentId);
// no FK because the parent is either Proposal or Contract — enforced in
// the service layer.
//
// `signatureImageKey` and `signedDocumentPdfKey` are MinIO/S3 object keys
// (not embedded blobs) so the row stays small and audit queries fast.
// The PDF snapshot is written async after signing.
model Signature {
  id                   String   @id @default(uuid())
  organizationId       String
  documentType         String   // 'proposal' | 'contract'
  documentId           String
  signerName           String
  signerEmail          String
  signatureImageKey    String   // MinIO object key for the PNG
  signedAt             DateTime
  ipAddress            String
  userAgent            String
  geoCountry           String?
  signedDocumentPdfKey String?  // MinIO object key for the snapshotted PDF
  // Audit trail — array of {at, type, ip, userAgent, detail}.
  // Event types: viewed, started_signing, completed, revoked.
  auditEvents          Json     @default("[]")
  revokedAt            DateTime?
  revokedReason        String?
  createdAt            DateTime @default(now())

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentType, documentId])
  @@index([organizationId, signedAt(sort: Desc)])
  @@map("signatures")
}

// ═══════════════════════════════════════════════════════════════
//  KNOWLEDGE BASE
// ═══════════════════════════════════════════════════════════════

model KnowledgeBaseGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  color          String?
  icon           String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles       KnowledgeBaseArticle[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("knowledge_base_groups")
}

model KnowledgeBaseArticle {
  id             String   @id @default(uuid())
  organizationId String
  groupId        String
  title          String
  slug           String
  content        String?
  // tsvector column populated by trigger — declared via raw SQL migration
  active         Boolean  @default(true)
  views          Int      @default(0)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group          KnowledgeBaseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

