  @@index([organizationId])
  @@map("client_subscriptions")
}

// ═══════════════════════════════════════════════════════════════
//  PROJECTS & TASKS
// ═══════════════════════════════════════════════════════════════

model Project {
  id              String   @id @default(uuid())
  organizationId  String
  clientId        String?
  name            String
  description     String?
  status          String   @default("not_started") // not_started | in_progress | on_hold | cancelled | finished
  billingType     String   @default("fixed_cost")  // fixed_cost | project_hours | task_hours | not_billable
  fixedRate       Decimal? @db.Decimal(15, 2)
  hourlyRate      Decimal? @db.Decimal(10, 2)
  budgetNotify    Boolean  @default(false)
  progressManual  Boolean  @default(false)
  progress        Int      @default(0)
  startDate       DateTime?
  deadline        DateTime?
  estimatedHours  Decimal? @db.Decimal(10, 2)
  settings        Json     @default("{}")  // client permissions matrix
  hash            String   @unique @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?       @relation(fields: [clientId], references: [id])
  members         ProjectMember[]
  milestones      Milestone[]
  tasks           Task[]
  expenses        Expense[]
  discussions     ProjectDiscussion[]
  files           ProjectFile[]
  timeEntries     TimeEntry[]
  notes           ProjectNote[]
  customFieldValues CustomFieldValue[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id             String @id @default(uuid())
  projectId      String
  userId         String
  hourlyRate     Decimal? @db.Decimal(10, 2)

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  dueDate        DateTime?
  completed      Boolean  @default(false)
  status         String   @default("planned") // planned | in_progress | done | cancelled
  completedAt    DateTime?
  color          String   @default("#6b7280")
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([organizationId])
  @@map("milestones")
}

model Task {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  milestoneId    String?
  relType        String?  // "project" | "lead" | "ticket" etc.
  relId          String?
  name           String
  description    String?
  status         String   @default("not_started") // not_started | in_progress | testing | awaiting_feedback | complete
  priority       String   @default("medium")      // low | medium | high | urgent
  startDate      DateTime?
  dueDate        DateTime?
  hourlyRate     Decimal? @db.Decimal(10, 2)
  billingType    String   @default("task_hours")
  estimatedHours Decimal? @db.Decimal(10, 2)
  order          Int      @default(0)
  isPublic       Boolean  @default(true)
  billable       Boolean  @default(false)
  createdBy      String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id])
  milestone      Milestone?      @relation(fields: [milestoneId], references: [id])
  assignments    TaskAssignment[]
  checklists     TaskChecklist[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  timeEntries    TimeEntry[]
  customFieldValues CustomFieldValue[]
  dependencies   TaskDependency[] @relation("TaskDependencies")
  dependedOnBy   TaskDependency[] @relation("TaskDependedOnBy")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@map("tasks")
}

model TaskDependency {
  id           String @id @default(uuid())
  taskId       String
  dependsOnId  String

  task         Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task @relation("TaskDependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

model TaskAssignment {
  taskId String
  userId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignments")
}

model TaskChecklist {
  id          String   @id @default(uuid())
  taskId      String
  description String
  completed   Boolean  @default(false)
  completedBy String?
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklists")
}

model TaskComment {
  id          String   @id @default(uuid())
  taskId      String
  userId      String?
  content     String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskAttachment {
  id          String   @id @default(uuid())
  taskId      String
  userId      String?
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model TimeEntry {
  id          String   @id @default(uuid())
  organizationId String
  taskId      String?
  projectId   String?
  userId      String
  description String?
  startTime   DateTime
  endTime     DateTime?
  seconds     Int      @default(0)
  billable    Boolean  @default(false)
  billed      Boolean  @default(false)
  note        String?
  hourlyRate  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task?    @relation(fields: [taskId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, userId])
  @@map("time_entries")
}

model ProjectDiscussion {
  id          String   @id @default(uuid())
  projectId   String
  userId      String?
  subject     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    ProjectDiscussionComment[]

  @@map("project_discussions")
}

model ProjectDiscussionComment {
  id           String   @id @default(uuid())
  discussionId String
  userId       String?
  content      String
  createdAt    DateTime @default(now())

  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("project_discussion_comments")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  userId      String?
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  visible     Boolean  @default(true) // visible to client
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ProjectNote {
  id          String   @id @default(uuid())
  projectId   String
  userId      String?
  content     String
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_notes")
}

// ═══════════════════════════════════════════════════════════════
//  SUPPORT TICKETS
// ═══════════════════════════════════════════════════════════════

model Department {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  email              String?
  hideFromClient     Boolean  @default(false)
  slaResponseHours   Int?     // max hours to first response
  slaResolutionHours Int?     // max hours to resolution
  createdAt          DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@index([organizationId])
  @@map("departments")
}

model Ticket {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  contactId      String?
  departmentId   String?
  assignedTo     String?
  subject        String
  message        String?
  status         String   @default("open")   // open | in_progress | answered | on_hold | closed
  priority       String   @default("medium") // low | medium | high | urgent
  service        String?
  source         String?  // "email" | "web" | "manual"
  hash           String   @unique @default(uuid())
  lastReplyAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
