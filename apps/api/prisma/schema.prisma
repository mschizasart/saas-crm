// ═══════════════════════════════════════════════════════════════
//  NEWSFEED (Internal Activity Wall)
// ═══════════════════════════════════════════════════════════════

model NewsfeedPost {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  content        String
  likes          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("newsfeed_posts")
}

// ═══════════════════════════════════════════════════════════════
//  AUTOMATION RULES
// ═══════════════════════════════════════════════════════════════

model AutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  trigger        String   // event name: "invoice.overdue", "lead.status_changed", "ticket.created", etc
  conditions     Json?    // optional conditions: { field: "status", operator: "equals", value: "won" }
  actions        Json     // array of actions: [{ type: "send_email", config: {...} }, { type: "update_field", config: {...} }]
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("automation_rules")
}

// ═══════════════════════════════════════════════════════════════
//  WEBHOOKS (Outgoing)
// ═══════════════════════════════════════════════════════════════

model Webhook {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  url             String
  events          String[]  // array of event names to subscribe to
  secret          String?   // for HMAC signature verification
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhooks")
}

// ═══════════════════════════════════════════════════════════════
//  API KEYS (per-organization)
// ═══════════════════════════════════════════════════════════════

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique  // bcrypt hash of the key
  keyPrefix      String    // first 8 chars for identification (e.g. "ak_abc12...")
  permissions    Json?     // optional permission restrictions
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ═══════════════════════════════════════════════════════════════
//  APPOINTMENTS
// ═══════════════════════════════════════════════════════════════

model Appointment {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  contactId      String?
  staffId        String?
  title          String
  description    String?
  location       String?
  startTime      DateTime
  endTime        DateTime
  status         String   @default("scheduled") // scheduled | confirmed | cancelled | completed
  reminderSent   Boolean  @default(false)
  hash           String   @unique @default(uuid())
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, staffId])
  @@map("appointments")
}

// ═══════════════════════════════════════════════════════════════
//  PRODUCTS / INVENTORY
// ═══════════════════════════════════════════════════════════════

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sku            String?
  unitPrice      Decimal  @db.Decimal(15, 2)
  costPrice      Decimal? @db.Decimal(15, 2)
  taxRate        Decimal  @db.Decimal(5, 2) @default(0)
  unit           String?
  stockQuantity  Int      @default(0)
  lowStockAlert  Int      @default(5)
  trackInventory Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      StockMovement[]
  invoiceItems   InvoiceItem[]
  estimateItems  EstimateItem[]
  proposalItems  ProposalItem[]

  @@index([organizationId])
  @@map("products")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  // Positive for increases, negative for decreases
  delta          Int
  // Stock level AFTER this movement (audit trail)
  balanceAfter   Int
  reason         String   // "invoice_sent" | "manual_adjustment" | "return" | "purchase" | "correction"
  // Optional refs
  invoiceId      String?
  creditNoteId   String?
  userId         String?
  note           String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

// ═══════════════════════════════════════════════════════════════
//  INBOX (generic IMAP sync) — v1, INBOUND only.
//  Outbound mail flows through EmailsService / nodemailer; we
//  record only its Message-ID in OutboundMessage so the inbox
//  router can thread inbound replies back to the originating record.
// ═══════════════════════════════════════════════════════════════

model InboxMessage {
  id               String   @id @default(uuid())
  organizationId   String
  // RFC822 Message-ID (incl. angle brackets) — used for dedup + threading.
  messageId        String
  inReplyTo        String?
  referenceIds     String[] @default([])
  fromEmail        String
  fromName         String?
  toEmails         String[] @default([])
  ccEmails         String[] @default([])
  subject          String?
  bodyText         String?
  bodyHtml         String?
  receivedAt       DateTime
  attachmentCount  Int      @default(0)
  // [{filename, contentType, size}] — bodies are NOT fetched in v1.
  attachmentsJson  Json     @default("[]")
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'ticket' | 'unmatched'
  routedTo         String   @default("unmatched")
  routedToId       String?
  isRead           Boolean  @default(false)
  isStarred        Boolean  @default(false)
  isArchived       Boolean  @default(false)
  rawHeadersJson   Json     @default("{}")
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, messageId])
  @@index([organizationId, routedTo, routedToId])
  @@index([organizationId, isArchived, receivedAt(sort: Desc)])
  @@map("inbox_messages")
}

model OutboundMessage {
  id               String    @id @default(uuid())
  organizationId   String
  // RFC822 Message-ID returned by nodemailer. Nullable because the row is
  // created BEFORE send (so we have a trackingId to embed in the HTML).
  messageId        String?
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'ticket' | 'proposal' | 'statement'
  routedTo         String
  routedToId       String
  subject          String?
  // Denormalised recipient email — useful for the "Sent emails" panel.
  recipientEmail   String?
  // ── Open / click tracking (migration 011) ─────────────────────────────
  trackingId       String?   @unique
  openedAt         DateTime?
  openCount        Int       @default(0)
  lastOpenedAt     DateTime?
  clickedAt        DateTime?
  clickCount       Int       @default(0)
  lastClickedAt    DateTime?
  /// JSONB: array of { url, at, ip, userAgent }; capped at 50 entries
  /// by the application to prevent runaway growth.
  clickedUrls      Json      @default("[]")
  sentAt           DateTime  @default(now())
  createdAt        DateTime  @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, messageId])
  @@index([organizationId, routedTo, routedToId])
  @@map("outbound_messages")
}

// ═══════════════════════════════════════════════════════════════
//  CROSS-RECORD SEARCH INDEX  (migration 012)
// ═══════════════════════════════════════════════════════════════
//
// Denormalised search rows — one per indexed business record across
// 8 entity types (lead | client | invoice | estimate | proposal |
// contract | ticket | product). Powers the Cmd-K palette and the
// /api/v1/search endpoint via Postgres FTS + pg_trgm.
//
// The actual `tsv` (tsvector) column is a STORED generated column
// added in 012-fts.sql — NOT modeled here, because Prisma has no
// first-class support for `GENERATED ALWAYS AS (...) STORED`. The
// indexer service writes only title/subtitle/body/url and Postgres
// keeps `tsv` in sync automatically.
model SearchIndex {
  id              String   @id @default(uuid())
  organizationId  String
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'proposal' | 'contract' | 'ticket' | 'product'
  entityType      String
  entityId        String
  // Primary display string — invoice number, client company, lead name, etc.
  title           String
  // Secondary line — e.g. "Invoice · Acme Ltd · $1,200 · paid"
  subtitle        String?
  // Long-form text concatenated for FTS (description, notes, line items, etc.)
  body            String?
  // Canonical relative URL the palette navigates to (e.g. /invoices/:id).
  url             String
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId])
  @@index([organizationId, entityType])
  @@map("search_index")
}

// ─────────────────────────────────────────────────────────────────────
//  Web push subscriptions (migration 014)
//
//  One row per (browser, user) pair. The endpoint is the URL handed to
//  us by the browser's PushManager.subscribe() — it's globally unique
//  because the push service issues a different one for each device.
//
//  When web-push delivers a 410 Gone the application deletes the row;
//  the browser revoked it (cleared site data, denied permission, etc.).
// ─────────────────────────────────────────────────────────────────────
model PushSubscription {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // The endpoint URL is what we POST to when sending a push. Globally
  // unique — duplicate subscribe() calls return the same value, so we
  // upsert by endpoint.
  endpoint       String
  // Public key the user agent generated for this subscription.
  p256dh         String
  // Authentication secret (also generated by the user agent).
  auth           String
  userAgent      String   @default("")
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@index([organizationId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════
//  DOCUMENT STORAGE (polymorphic, versioned)
// ═══════════════════════════════════════════════════════════════
//
// A `Document` is a logical file attached to any record (client,
// invoice, estimate, project, ticket, lead). It is polymorphic on
// (entityType, entityId) — no FK, because the parent is one of many
// tables; the service layer validates the entity exists in the org.
//
// Each upload of a new revision creates a `DocumentVersion` row with a
// monotonically-increasing 1-based `version` number. The bytes live in
// MinIO (see StorageService); the DB only holds metadata + the object
// key. `Document.currentVersionId` points at the latest version.
model Document {
  id               String   @id @default(uuid())
  organizationId   String
  entityType       String   // 'client' | 'invoice' | 'estimate' | 'project' | 'ticket' | 'lead'
  entityId         String   // polymorphic — no FK
  name             String   // display filename
  currentVersionId String?  // points at the latest DocumentVersion
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  organizationId String
  version        Int      // 1-based
  storageKey     String   // MinIO object key
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedById   String?
  note           String?  // version comment
  createdAt      DateTime @default(now())

  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}
