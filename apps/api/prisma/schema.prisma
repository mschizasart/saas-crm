// ═══════════════════════════════════════════════════════════════
//  PROPOSALS
// ═══════════════════════════════════════════════════════════════

model Proposal {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  relType        String?  // "lead" | "customer"
  relId          String?
  subject        String
  content        String?
  status         String   @default("draft") // draft | sent | open | revised | declined | accepted
  currency       String?
  total          Decimal? @db.Decimal(15, 2)
  discount       Decimal? @db.Decimal(15, 2)
  discountType   String?
  openTill       DateTime?
  hash           String   @unique @default(uuid())
  signature      String?  // base64 SVG/PNG
  signedAt       DateTime?
  signedName     String?
  sentAt         DateTime?
  dateCreated    DateTime
  allowComments  Boolean  @default(true)
  // E-signature toggle — when true, the public view requires a drawn signature
  // (creates a Signature row with audit trail). Otherwise the legacy
  // click-to-accept flow is used.
  signatureRequired Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id])
  items          ProposalItem[]
