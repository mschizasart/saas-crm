}

// ═══════════════════════════════════════════════════════════════
//  CUSTOM FIELDS (polymorphic)
// ═══════════════════════════════════════════════════════════════

model CustomField {
  id             String   @id @default(uuid())
  organizationId String
  // "client" | "contact" | "invoice" | "estimate" | "proposal" | "expense"
  // | "project" | "task" | "ticket" | "lead" | "contract"
  fieldTo        String
  name           String
  slug           String
  type           String   // "text" | "textarea" | "select" | "number" | "date" | "checkbox" | "url" | "email"
  options        String[] @default([]) // for select type
  defaultValue   String?
  placeholder    String?
  required       Boolean  @default(false)
  showOnTable    Boolean  @default(false)
  showOnPdf      Boolean  @default(false)
  showOnPortal   Boolean  @default(false)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // ── Custom Fields v2 — COMPUTED fields (migration 021) ──────────────
  // fieldKind discriminates static input fields from read-only computed
  // fields. Existing rows default to "input" (a plain user-entered value).
  //   "input"   — user-entered value stored in CustomFieldValue (legacy).
  //   "formula" — evaluated from formulaExpr over sibling field values +
  //               a whitelist of the entity's own numeric columns. Pure
  //               arithmetic only; evaluated by a sandboxed shunting-yard
  //               parser (NO eval/Function/vm). Never persisted.
  //   "lookup"  — pulls one field off a related (same-org) record.
  //   "rollup"  — aggregates a field over child (same-org) records.
  fieldKind      String   @default("input")
  // formula: e.g. "quantity * unitPrice" or "subtotal * 0.2".
  formulaExpr    String?
  // lookup:  { relation: "client", field: "company" }
  lookupConfig   Json?
  // rollup:  { relation: "invoices", op: "sum"|"count"|"avg"|"min"|"max", field: "total" }
  rollupConfig   Json?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, fieldTo, slug], map: "custom_fields_org_fieldTo_slug_key")
  @@index([organizationId, fieldTo])
  @@map("custom_fields")
}

model CustomFieldValue {
  id             String   @id @default(uuid())
  organizationId String
  fieldId        String
  // Polymorphic target
  relType        String   // matches CustomField.fieldTo
  relId          String
  value          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  field          CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  // Polymorphic — optional relations for type checking only
  client         Client?   @relation(fields: [relId], references: [id], map: "cfv_client")
  invoice        Invoice?  @relation(fields: [relId], references: [id], map: "cfv_invoice")
  estimate       Estimate? @relation(fields: [relId], references: [id], map: "cfv_estimate")
  proposal       Proposal? @relation(fields: [relId], references: [id], map: "cfv_proposal")
  lead           Lead?     @relation(fields: [relId], references: [id], map: "cfv_lead")
  project        Project?  @relation(fields: [relId], references: [id], map: "cfv_project")
  task           Task?     @relation(fields: [relId], references: [id], map: "cfv_task")
  ticket         Ticket?   @relation(fields: [relId], references: [id], map: "cfv_ticket")
  contract       Contract? @relation(fields: [relId], references: [id], map: "cfv_contract")

  @@unique([fieldId, relId])
  @@index([organizationId, relType, relId])
  @@map("custom_field_values")
}

