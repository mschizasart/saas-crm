model Todo {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  description    String
  completed      Boolean  @default(false)
  order          Int      @default(0)
  dueDate        DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, userId])
  @@map("todos")
}

// ═══════════════════════════════════════════════════════════════
//  2-WAY CALENDAR SYNC (migration 025)
// ═══════════════════════════════════════════════════════════════

// One row per (user, provider). Holds the encrypted OAuth tokens and the
// per-connection sync state. Tokens are AES-256-GCM encrypted with
// ENCRYPTION_KEY (same scheme as EmailSettings.oauth*). See
// modules/calendar/calendar-sync.service.ts.
model CalendarSync {
  id                 String    @id @default(uuid())
  organizationId     String
  userId             String
  // 'google' | 'microsoft'
  provider           String
  // AES-256-GCM encrypted (iv:tag:cipher hex) — never returned raw.
  refreshToken       String
  // Cached access token, also encrypted; refreshed on demand.
  accessToken        String?
  tokenExpiresAt     DateTime?
  // Which remote calendar to read/write. NULL = the account's primary.
  externalCalendarId String?
  syncEnabled        Boolean   @default(true)
  // 'both' | 'push' | 'pull'
  syncDirection      String    @default("both")
  lastSyncedAt       DateTime?
  lastSyncError      String?
  // The email the user consented with (display only).
  connectedEmail     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([organizationId])
  @@index([syncEnabled])
  @@map("calendar_syncs")
}

// ═══════════════════════════════════════════════════════════════
//  CLOCK IN/OUT (Staff time tracking)
// ═══════════════════════════════════════════════════════════════

model ClockEntry {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  clockIn        DateTime
  clockOut       DateTime?
  note           String?
  totalMinutes   Int?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

