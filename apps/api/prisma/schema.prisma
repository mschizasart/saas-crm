// Per-organization SMTP / sender configuration.
// When absent OR provider = PLATFORM_DEFAULT, the app falls back to
// process.env SMTP_* values.
model EmailSettings {
  id                    String    @id @default(uuid())
  organizationId        String    @unique
  // SMTP | PLATFORM_DEFAULT | GMAIL_OAUTH | MICROSOFT_OAUTH | SENDGRID (stub) | POSTMARK (stub)
  provider              String    @default("PLATFORM_DEFAULT")
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPassword          String?   // AES-256-GCM encrypted (iv:tag:cipher hex)
  smtpSecure            Boolean   @default(false)
  fromName              String?
  fromEmail             String?
  replyToEmail          String?
  // ── OAuth 2.0 (Gmail / Microsoft) ──────────────────────────────────────
  oauthRefreshToken     String?   // AES-256-GCM encrypted
  oauthAccessToken      String?   // AES-256-GCM encrypted (short-lived cache)
  oauthTokenExpiresAt   DateTime?
  oauthConnectedEmail   String?   // the mailbox address granted by consent
  oauthConnectedAt      DateTime?
  // ── IMAP inbox sync ────────────────────────────────────────────────────
  // For OAuth providers, IMAP authenticates via XOAUTH2 using the existing
  // oauthRefreshToken — no separate IMAP credentials needed for those.
  imapHost              String?
  imapPort              Int?
  imapUser              String?
  imapPassword          String?   // AES-256-GCM encrypted (iv:tag:cipher hex)
  imapTls               Boolean   @default(true)
  imapEnabled           Boolean   @default(false)
  imapLastUidNext       Int?      // INBOX UIDNEXT high-water mark
  imapLastSyncedAt      DateTime?
  imapLastError         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

// Per-organization AI provider configuration (migration 015).
// When absent OR provider = PLATFORM_DEFAULT, AI features fall back to the
// platform-level ANTHROPIC_API_KEY env var. When a tenant brings their own
// key, the platform no longer subsidises their token spend.
model AiSettings {
  id                   String    @id @default(uuid())
  organizationId       String    @unique
  // ANTHROPIC | OPENAI | PLATFORM_DEFAULT
  provider             String    @default("PLATFORM_DEFAULT")
  apiKey               String?   // AES-256-GCM encrypted (iv:tag:cipher hex) — never returned raw
  model                String?   // e.g. claude-haiku-4-5-20251001, gpt-4o-mini
  enabled              Boolean   @default(true)
  // Soft monthly token cap — checked before each call, not mid-stream.
  monthlyTokenCap      Int?
  tokensUsedThisMonth  Int       @default(0)
  usageResetAt         DateTime? // start of the current usage window
  lastTestedAt         DateTime?
  lastTestError        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Per-organization SMS (Twilio) configuration (migration 022).
// One row per org. When absent OR enabled = false, SMS sending is disabled
// for the tenant. authToken is AES-256-GCM encrypted at rest and never
// returned raw (redacted to `authTokenSet` boolean on read).
model SmsSettings {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  // Currently only TWILIO; column kept generic for future providers.
  provider        String   @default("TWILIO")
  accountSid      String?  // Twilio Account SID (public-ish, not encrypted)
  authToken       String?  // AES-256-GCM encrypted (iv:tag:cipher hex) — never returned raw
  fromNumber      String?  // the tenant's Twilio number, E.164 (e.g. +14155551234)
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sms_settings")
}

// SMS message log — both outbound (sent via Twilio) and inbound (received
// through the Twilio webhook). Attached to a CRM record via entityType /
// entityId when known. See migration 022.
model SmsMessage {
  id              String   @id @default(uuid())
  organizationId  String
  direction       String   // 'outbound' | 'inbound'
  entityType      String?  // 'ticket' | 'lead' | 'client'
  entityId        String?
  toNumber        String
  fromNumber      String
  body            String
  // 'queued' | 'sent' | 'delivered' | 'failed' | 'received'
  status          String
  providerSid     String?  // Twilio message SID (e.g. SMxxxxxxxx)
  errorMessage    String?
  sentById        String?  // staff user who sent it (outbound only)
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("sms_messages")
}

// Per-organization e-invoice / UBL XML configuration.
// When absent, EinvoiceService falls back to its built-in defaults so
// non-EU tenants are unaffected. Targeted at tenants that need to issue
// PEPPOL BIS Billing 3.0 / Factur-X / generic UBL invoices.
model EInvoiceSettings {
  id                  String    @id @default(uuid())
  organizationId      String    @unique
  // Allowed: 'PEPPOL_UBL_2_1' | 'FACTUR_X' | 'GENERIC_UBL'
  format              String    @default("PEPPOL_UBL_2_1")
  // PEPPOL participant id, e.g. "0088:1234567890123" (GLN). Includes the scheme prefix.
  senderId            String?
  // ICD scheme code from the PEPPOL list: '0088' (GLN), '0184' (DK CVR), '0007' (SE Org), …
  senderIdScheme      String?
  senderName          String?
  senderTaxId         String?
  senderAddress       String?
  senderCity          String?
  senderPostcode      String?
  // ISO 3166-1 alpha-2 country code.
  senderCountry       String?
  defaultCurrency     String?   @default("EUR")
  // UN/CEFACT 4461 payment means code, e.g. '30' = credit transfer.
  paymentMeansCode    String?   @default("30")
  // Free-form XML appended into a designated extension point of the document.
  // Validated for well-formedness only; tenants are responsible for schema compliance.
  customXmlSnippet    String?
  enabled             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("einvoice_settings")
}

// Per-organization automatic sales-tax / VAT configuration (migration 023).
// This is an OPT-IN layer on top of the existing manual `Tax` rates
// (taxes table + tax1/tax2 on line items). When provider = NONE or
// enabled = false, nothing changes: invoices keep using manual tax ids.
// When enabled + autoApply, totals are computed via TaxJar/Avalara and the
// manual tax1/tax2 are ignored for the persisted totalTax (precedence:
// auto > manual). A provider error never blocks invoice save — it degrades
// to manual/zero tax (see TaxConfigService).
model TaxSettings {
  id                  String    @id @default(uuid())
  organizationId      String    @unique
  // NONE | TAXJAR | AVALARA
  provider            String    @default("NONE")
  // AES-256-GCM encrypted (iv:tag:cipher hex) — never returned raw.
  // For TaxJar this is the API token; for Avalara it is the license key.
  apiKey              String?
  // Avalara needs account id + license (apiKey) + a company code.
  // avalaraAccountId is the Basic-auth USERNAME (the non-secret half of the
  // credential) — stored plaintext ON PURPOSE and returned to anyone with
  // settings.view so admins can confirm their config. The secret half (the
  // license key) lives in `apiKey` and IS encrypted.
  avalaraAccountId    String?
  avalaraCompanyCode  String?
  // The address the tenant ships/bills FROM (origin / nexus).
  // Shape: { street, city, state, zip, country }
  originAddress       Json?
  enabled             Boolean   @default(false)
  // false = manual "Calculate tax" button only; true = auto-calc on every save.
  autoApply           Boolean   @default(false)
  lastTestedAt        DateTime?
  lastTestError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tax_settings")
}

// Audit / cache of automatic tax calculations (migration 023). One row per
// successful provider calculation so we can show the jurisdiction breakdown
// and avoid re-calling the provider on every render.
model TaxCalculation {
  id              String    @id @default(uuid())
  organizationId  String
  // 'invoice' | 'estimate'
  entityType      String
  entityId        String
  // NONE | TAXJAR | AVALARA — provider used for this calc.
  provider        String
  taxableAmount   Decimal   @db.Decimal(15, 2)
  taxAmount       Decimal   @db.Decimal(15, 2)
  // Effective combined rate as a percentage, e.g. 8.875.
  rate            Decimal   @db.Decimal(7, 4)
  // Raw jurisdiction breakdown returned by the provider.
  breakdown       Json?
  calculatedAt    DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@map("tax_calculations")
}

