  active         Boolean  @default(true)
  trigger        String   // event name: "invoice.overdue", "lead.status_changed", "ticket.created", etc
  conditions     Json?    // optional conditions: { field: "status", operator: "equals", value: "won" }
  actions        Json     // array of actions: [{ type: "send_email", config: {...} }, { type: "update_field", config: {...} }]
  createdAt      DateTime @default(now())

