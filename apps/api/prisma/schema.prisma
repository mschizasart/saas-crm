// ─────────────────────────────────────────────────────────────
//  SaaS CRM — Prisma Schema
//  PostgreSQL 16 with Row-Level Security for tenant isolation
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  PLATFORM LEVEL (no RLS — super-admin only)
// ═══════════════════════════════════════════════════════════════

model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  // 2FA (TOTP) — see modules/platform/twofa flow.
  // Secret is the AES-256-GCM-encrypted base32 TOTP secret (encrypt.ts).
  // Recovery codes are stored as a JSON array of bcrypt hashes.
  twoFactorSecret         String?
  twoFactorEnabled        Boolean   @default(false)
  twoFactorRecoveryCodes  Json?
  twoFactorEnrolledAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique          // subdomain
  customDomain       String?   @unique
  logo               String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  country            String?
  phone              String?
  website            String?
  vatNumber          String?
  // SaaS billing
  planId             String?                    // Stripe price ID
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus String    @default("trialing") // trialing | active | past_due | canceled | unpaid
  subscriptionPlan   String?                    // slug of PlatformPlan
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  // Usage limits (override plan defaults)
  maxStaff           Int       @default(5)
  maxClients         Int       @default(50)
  maxActiveProjects  Int       @default(10)
  storageBytes       BigInt    @default(0)
  // Settings (replaces flat tbloptions key-value table)
  settings           Json      @default("{}")
  // Onboarding wizard state (see manual-migrations/016-onboarding.sql)
  onboardingCompletedAt DateTime?
  onboardingStep        String?
  onboardingSkipped     Boolean   @default(false)
  // White-label branding (see manual-migrations/020-branding.sql).
  // NOTE: the existing `logo` column above is REUSED as the brand logo —
  // there is intentionally no separate `brandLogoUrl`.
  brandPrimaryColor  String?                    // hex, e.g. #3B82F6 — accent/primary
  brandSidebarColor  String?                    // hex — sidebar background (falls back to default dark)
  brandFaviconUrl    String?                    // optional favicon URL
  brandEmailFooter   String?                    // optional HTML/text appended to outgoing mail
  whiteLabelEnabled  Boolean   @default(false)  // master toggle; false = platform defaults
  // Wave F3 — reporting / display base currency (ISO 4217). Distinct
  // from the per-org `currencies.isDefault` flag (legacy formatting).
  // FxService.convert() uses this when no `to` currency is specified.
  baseCurrency       String    @default("USD")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  users              User[]
  roles              Role[]
  clients            Client[]
  leads              Lead[]
  invoices           Invoice[]
  estimates          Estimate[]
  proposals          Proposal[]
  payments           Payment[]
  creditNotes        CreditNote[]
  expenses           Expense[]
  projects           Project[]
  tasks              Task[]
  tickets            Ticket[]
  contracts          Contract[]
  surveys            Survey[]
  goals              Goal[]
  announcements      Announcement[]
  currencies         Currency[]
  taxes              Tax[]
  paymentModes       PaymentMode[]
  customFields       CustomField[]
  emailTemplates     EmailTemplate[]
  knowledgeBaseGroups KnowledgeBaseGroup[]
  departments        Department[]
  leadStatuses       LeadStatus[]
  leadSources        LeadSource[]
  expenseCategories  ExpenseCategory[]
  contractTypes      ContractType[]
  clientGroups       ClientGroup[]
  events             Event[]
  savedItems         SavedItem[]
  predefinedReplies  PredefinedReply[]
  clockEntries       ClockEntry[]
  newsfeedPosts      NewsfeedPost[]
  automationRules    AutomationRule[]
  webhooks           Webhook[]
  apiKeys            ApiKey[]
  appointments       Appointment[]
  products           Product[]
  stockMovements     StockMovement[]
  emailSettings      EmailSettings?
  aiSettings         AiSettings?
  smsSettings        SmsSettings?
  smsMessages        SmsMessage[]
  einvoiceSettings   EInvoiceSettings?
  taxSettings        TaxSettings?
  taxCalculations    TaxCalculation[]
  calendarSyncs      CalendarSync[]
  leadForms          LeadForm[]
  estimateRequestForms EstimateRequestForm[]
  ticketSpamFilters  TicketSpamFilter[]
  inboxMessages      InboxMessage[]
  outboundMessages   OutboundMessage[]
  signatures         Signature[]
  documents          Document[]
  documentVersions   DocumentVersion[]
  dunningSettings    DunningSettings?
  dunningRules       DunningRule[]
  dunningLogs        DunningLog[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]
  emailUnsubscribes  EmailUnsubscribe[]
  // Opportunities (deal pipeline) — migration 027
  opportunityStages       OpportunityStage[]
  opportunities           Opportunity[]
  opportunityStageHistory OpportunityStageHistory[]
  // Multi-org membership: every User row that explicitly belongs to this
  // org via the new many-to-many table. The legacy `users` relation above
  // (via `User.organizationId`) represents the user's primary/legacy org;
  // this back-relation enumerates *additional* org memberships.
  userMemberships    UserOrganizationMembership[]
  // CPQ (Wave F2 — migration 034)
  productBundles     ProductBundle[]
  bundleItems        BundleItem[]
  quotes             Quote[]
  quoteLineItems     QuoteLineItem[]

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════════
//  USERS & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  password       String?               // null for OAuth-only users; phpass hash during migration
  passwordFormat String    @default("bcrypt") // "bcrypt" | "phpass" — transition field
  firstName      String
  lastName       String
  // "staff" | "contact" — replaces separate tblstaff / tblcontacts split
  type           String    @default("staff")
  isAdmin        Boolean   @default(false)
  active         Boolean   @default(true)
  // Staff-specific
  roleId         String?
  hourlyRate     Decimal?  @db.Decimal(10, 2)
  department     String?
  jobTitle       String?
  // Contact-specific (when type = "contact")
  clientId       String?
  isPrimary      Boolean   @default(false)
  // Profile
  avatar         String?
  phone          String?
  phoneMobile    String?
  skype          String?
  direction      String    @default("ltr")
  language       String    @default("en")
  timezone       String    @default("UTC")
  lastLogin      DateTime?
  lastIp         String?
  // 2FA (legacy fields, kept for backward-compat with existing rows;
  //  new code should use the twoFactor* set below)
  twoFaEnabled   Boolean   @default(false)
  twoFaSecret    String?
  // 2FA (TOTP) — new fields; see modules/auth/twofa.* flow.
  // twoFactorSecret holds the AES-256-GCM-encrypted base32 TOTP secret.
  // twoFactorRecoveryCodes is a JSON array of bcrypt hashes (one-time codes).
  twoFactorSecret         String?
  twoFactorEnabled        Boolean   @default(false)
  twoFactorRecoveryCodes  Json?
  twoFactorEnrolledAt     DateTime?
  // OAuth
  oauthProvider  String?   // "google" | "microsoft"
  oauthId        String?
  // Email / notification prefs
  emailNotifications Boolean @default(true)
  // Email change flow — pending new email awaiting token confirmation
  pendingEmail        String?
  pendingEmailToken   String?
  pendingEmailExpires DateTime?
  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])
  sessions       UserSession[]
  notifications  Notification[]
  assignedTasks  TaskAssignment[]
  timeEntries    TimeEntry[]
  activityLogs   ActivityLog[]
  clockEntries   ClockEntry[]
  newsfeedPosts  NewsfeedPost[]
  permissionOverrides UserPermissionOverride[]
  pushSubscriptions   PushSubscription[]
  // Opportunities — migration 027
  ownedOpportunities       Opportunity[]            @relation("OpportunityOwner")
  stageHistoryChanges      OpportunityStageHistory[] @relation("OpportunityStageHistoryChangedBy")
  // CPQ (Wave F2 — migration 034)
  createdProductBundles    ProductBundle[]          @relation("ProductBundleCreatedBy")
  createdQuotes            Quote[]                  @relation("QuoteCreatedBy")
  // Field service (Wave H1 — migration 039). A user can be a technician
  // (assignable on work orders) only when `isTechnician` is true. The flag
  // is set on the staff edit page; assigning a non-technician throws a 400
  // in WorkOrdersService. The DB-level FKs in 039-field-service.sql still
  // reference users(id) directly; we keep this side self-contained and
  // avoid adding back-relations on User to mirror the Wave G2 pattern.
  isTechnician   Boolean   @default(false)
  // Multi-org: a single human (User row) can be a member of multiple
  // organizations. See `UserOrganizationMembership`. The legacy scalar
  // `organizationId` above remains the user's *primary* org and the
  // tenant the row is anchored to for RLS; memberships add additional
  // orgs the same user can switch into without re-registering.
  memberships    UserOrganizationMembership[]
  // Role hierarchy (Wave G1 — migration 036). Self-referential FK so
  // each user points at their manager. Drives hierarchical record
  // sharing (RecordSharingService.applyVisibilityScope).
  managerId       String?
  manager         User?    @relation("UserReportsHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports   User[]   @relation("UserReportsHierarchy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, type])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
//  Multi-org membership join table
//  One row per (user, organization) pair the user can access.
//  See manual-migrations/017-multi-org-membership.sql for the
//  matching DDL + backfill.
// ─────────────────────────────────────────────────────────────
model UserOrganizationMembership {
  id              String   @id @default(uuid())
  userId          String
  organizationId  String
  // Coarse "role tier" string — 'admin' | 'staff' | 'owner'. Drives the
  // `isAdmin` bypass in JwtStrategy (admin/owner → isAdmin). This is NOT
  // the granular permission set; see `roleId` below for that. Conceptually
  // this is the membership's "roleTier"; the column name stays `role` for
  // backward compatibility with migration 017.
  role            String   // 'admin' | 'staff' | 'owner' — role TIER, drives isAdmin
  // FK to a Role in the SAME org as this membership. Carries the granular
  // `permissions` JSON used by RbacGuard for the ACTIVE org. Nullable: a
  // membership can exist before any Role is assigned, in which case the
  // user fails closed to no permissions in that org. ON DELETE SET NULL so
  // deleting a Role downgrades affected members to fail-closed rather than
  // cascading the membership away. See migration 018-membership-role-fk.sql.
  roleId          String?
  isPrimary       Boolean  @default(false)  // user's default org on login
  invitedAt       DateTime @default(now())
  acceptedAt      DateTime?

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The granular per-org Role (with its permissions JSON). The application
  // layer is responsible for ensuring the referenced Role belongs to the
  // same `organizationId` as this membership (the DB FK alone can't express
  // that cross-column constraint). Named `membershipRole` to avoid clashing
  // with the `role` tier string field above.
  membershipRole  Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("user_organization_memberships")
}

model UserPermissionOverride {
  id             String   @id @default(uuid())
  userId         String
  permission     String   // e.g. "invoices.delete"
  grant          Boolean  // true = add; false = revoke inherited role permission
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permission_overrides")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // JSONB — e.g. {"invoices":{"view":true,"create":true},"clients":{"view":true}}
  permissions    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  // Back-relation for per-org memberships that point at this Role via
  // UserOrganizationMembership.roleId (granular per-org permissions).
  memberships    UserOrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// ═══════════════════════════════════════════════════════════════
//  CLIENTS & CONTACTS
// ═══════════════════════════════════════════════════════════════

model ClientGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        Client[]

  @@index([organizationId])
  @@map("client_groups")
}

model Client {
  id                    String   @id @default(uuid())
  organizationId        String
  groupId               String?
  company               String
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  country               String?
  website               String?
  phone                 String?
  vat                   String?
  currencyId            String?
  defaultLanguage       String   @default("en")
  active                Boolean  @default(true)
  registrationNumber    String?
  billingStreet         String?
  billingCity           String?
  billingState          String?
  billingZip            String?
  billingCountry        String?
  shippingStreet        String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  shippingCountry       String?
  longitude             String?
  latitude              String?
  stripeId              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group                 ClientGroup?  @relation(fields: [groupId], references: [id])
  currency              Currency?     @relation(fields: [currencyId], references: [id])
  contacts              User[]
  invoices              Invoice[]
  estimates             Estimate[]
  proposals             Proposal[]
  projects              Project[]
  tickets               Ticket[]
  contracts             Contract[]
  payments              Payment[]
  creditNotes           CreditNote[]
  expenses              Expense[]
  subscriptions         ClientSubscription[]
  vaultEntries          VaultEntry[]
  customFieldValues     CustomFieldValue[]
  // Opportunities — migration 027
  opportunities         Opportunity[]
  // CPQ (Wave F2 — migration 034)
  quotes                Quote[]

  // Account hierarchy (Wave F1 — migration 033). Self-referential
  // parent/child link so a logical customer can span several Client
  // rows (subsidiaries, divisions). ON DELETE SET NULL keeps the
  // children as new roots if the parent is removed.
  parentClientId  String?
  parent          Client?  @relation("ClientHierarchy", fields: [parentClientId], references: [id], onDelete: SetNull)
  children        Client[] @relation("ClientHierarchy")
  // Wave H1 back-relation. WorkOrder forward FK lives on the
  // WorkOrder side.
  workOrders      WorkOrder[] @relation("ClientWorkOrders")

  @@index([organizationId])
  @@map("clients")
}

model VaultEntry {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String
  name           String
  username       String?
  password       String?  // encrypted
  url            String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("vault_entries")
}

// ═══════════════════════════════════════════════════════════════
//  CURRENCIES & FINANCIAL SETTINGS
// ═══════════════════════════════════════════════════════════════

model Currency {
  id             String   @id @default(uuid())
  organizationId String
  // ISO 4217 code (USD, EUR, …) — used for API/gateway interop
  code           String?
  name           String
  symbol         String
  symbolPlacement String  @default("before") // "before" | "after"
  decimalSeparator String @default(".")
  thousandSeparator String @default(",")
  decimalPlaces  Int      @default(2)
  isDefault      Boolean  @default(false)
  exchangeRate   Decimal  @default(1) @db.Decimal(15, 6)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        Client[]
  invoices       Invoice[]
  estimates      Estimate[]
  expenses       Expense[]

  @@index([organizationId])
  @@map("currencies")
}

model Tax {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  rate           Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("taxes")
}

model PaymentMode {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  gatewayClass   String?  // "stripe" | "paypal" | "mollie" | "manual" etc.
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoicePayments InvoicePaymentMode[]
  payments       Payment[]

  @@index([organizationId])
  @@map("payment_modes")
}

// ═══════════════════════════════════════════════════════════════
//  LEADS
// ═══════════════════════════════════════════════════════════════

model LeadStatus {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String   @default("#6b7280")
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@index([organizationId])
  @@map("lead_statuses")
}

model LeadSource {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@index([organizationId])
  @@map("lead_sources")
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String
  statusId       String?
  sourceId       String?
  assignedTo     String?
  name           String
  company        String?
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  description    String?
  value          Decimal? @db.Decimal(15, 2)
  // Kanban position within status column
  position       Int      @default(0)
  isPublic       Boolean  @default(false)
  lostReason     String?
  convertedAt    DateTime?
  convertedToClientId String?
  lastContact    DateTime?
  // ── AI-powered lead score (migration 013) ──────────────────────────
  // 0-100 composite score: heuristic activity signals + AI intent extract.
  // Null = never scored; recomputed on lead.created / lead.updated /
  // inbox.routed-to-lead via the BullMQ 'lead-scoring' queue. See
  // lead-scoring.service.ts for the formula.
  score          Int?
  scoreReason    String?  @db.Text
  scoreUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         LeadStatus?  @relation(fields: [statusId], references: [id])
  source         LeadSource?  @relation(fields: [sourceId], references: [id])
  notes          LeadNote[]
  emails         LeadEmail[]
  customFieldValues CustomFieldValue[]
  // Opportunities — migration 027
  opportunities  Opportunity[]

  @@index([organizationId])
  @@index([organizationId, statusId])
  // "Hot leads" sort: highest score first, NULLs last (unscored leads at end)
  @@index([organizationId, score(sort: Desc)])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model LeadEmail {
  id        String   @id @default(uuid())
  leadId    String
  direction String   @default("outbound") // "outbound" | "inbound"
  subject   String?
  body      String?
  fromEmail String?
  toEmail   String?
  sentAt    DateTime @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_emails")
}

// Public web-to-lead form. Each row is a form an org exposes on the
// internet; submissions create a Lead row tied to `organizationId`.
model LeadForm {
  id               String   @id @default(uuid())
  organizationId   String
  slug             String                       // unique per org — used in public URL
  name             String                       // internal name (for admin list)
  title            String                       // heading shown on the public form
  description      String?                      // optional intro copy
  fields           Json                         // [{key,label,type,required,options?}]
  redirectUrl      String?                      // optional URL to redirect to after submit
  captchaEnabled   Boolean  @default(true)      // enables honeypot + any future captcha
  notifyEmail      String?                      // staff email to notify on submit
  assignToUserId   String?                      // default Lead.assignedTo for new submissions
  isActive         Boolean  @default(true)
  submissionCount  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("lead_forms")
}

// Public "Request a quote" form. Submissions create draft Estimates that
// the tenant reviews and finalises. Mirrors LeadForm in shape; differs by
// also tracking a default client + currency to seed the resulting estimate.
model EstimateRequestForm {
  id                 String   @id @default(uuid())
  organizationId     String
  slug               String                       // unique per org — used in public URL
  name               String                       // internal name (for admin list)
  title              String                       // heading shown on the public form
  description        String?                      // optional intro copy
  fields             Json                         // [{key,label,type,required,options?}]
  defaultClientId    String?                      // if set, requests attach to this existing client
  defaultCurrencyId  String?                      // override org default currency for the estimate
  redirectUrl        String?                      // optional URL to redirect to after submit
  captchaEnabled     Boolean  @default(true)      // enables honeypot + any future captcha
  notifyEmail        String?                      // staff email to notify on submit
  assignToUserId     String?                      // hint for assignee (free-text; estimate has no assignee column)
  isActive           Boolean  @default(true)
  submissionCount    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("estimate_request_forms")
}

// ═══════════════════════════════════════════════════════════════
//  INVOICES
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id               String   @id @default(uuid())
  organizationId   String
  clientId         String?
  currencyId       String?
  number           String   // e.g. "INV-0001"
  referenceNumber  String?
  status           String   @default("draft") // draft | unpaid | partial | paid | overdue | cancelled
  date             DateTime
  dueDate          DateTime?
  subTotal         Decimal  @db.Decimal(15, 2) @default(0)
  discount         Decimal  @db.Decimal(15, 2) @default(0)
  discountType     String   @default("fixed")  // "fixed" | "percent"
  adjustment       Decimal  @db.Decimal(15, 2) @default(0)
  total            Decimal  @db.Decimal(15, 2) @default(0)
  totalTax         Decimal  @db.Decimal(15, 2) @default(0)
  clientNote       String?
  adminNote        String?
  terms            String?
  // Allowed payment gateways for this invoice
  allowedPaymentModes String[] @default([])
  // Recurring invoice settings
  isRecurring      Boolean  @default(false)
  recurringEvery   Int?
  recurringType    String?  // "day" | "week" | "month" | "year"
  recurringFrom    String?  // null | date
  totalCycles      Int?     // null = infinite
  totalCyclesCompleted Int  @default(0)
  lastRecurringDate DateTime?
  nextRecurringDate DateTime?
  recurringFromInvoiceId String?
  // Hash for public URL access (no login needed)
  hash             String   @unique @default(uuid())
  sentAt           DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client?      @relation(fields: [clientId], references: [id])
  currency         Currency?    @relation(fields: [currencyId], references: [id])
  items            InvoiceItem[]
  payments         Payment[]
  creditNotes      CreditNote[]
  customFieldValues CustomFieldValue[]
  paymentAttempts  PaymentAttempt[]
  dunningLogs      DunningLog[]
  // CPQ (Wave F2 — migration 034). Back-relation for Quote.convertedInvoiceId.
  convertedFromQuotes Quote[]      @relation("QuoteConvertedInvoice")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  longDesc    String?
  qty         Decimal  @db.Decimal(10, 2) @default(1)
  rate        Decimal  @db.Decimal(15, 2) @default(0)
  tax1        String?  // tax id
  tax2        String?  // tax id
  unit        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  clientId       String?
  paymentModeId  String?
  amount         Decimal  @db.Decimal(15, 2)
  currency       String?
  transactionId  String?
  note           String?
  paymentDate    DateTime
  gatewayResponse Json?
  // Refund tracking (additive)
  refundedAt     DateTime?
  refundedAmount Decimal? @db.Decimal(15, 2)
  refundReason   String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])
  paymentMode    PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([organizationId])
  @@map("payments")
}

model InvoicePaymentMode {
  invoiceId     String
  paymentModeId String

  paymentMode   PaymentMode @relation(fields: [paymentModeId], references: [id])

  @@id([invoiceId, paymentModeId])
  @@map("invoice_payment_modes")
}

model PaymentAttempt {
  id          String   @id @default(uuid())
  invoiceId   String
  gateway     String
  amount      Decimal  @db.Decimal(15, 2)
  status      String   // "pending" | "success" | "failed"
  response    Json?
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

model CreditNote {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  invoiceId      String?
  number         String
  status         String   @default("open") // open | closed | void
  date           DateTime
  subTotal       Decimal  @db.Decimal(15, 2) @default(0)
  discount       Decimal  @db.Decimal(15, 2) @default(0)
  discountType   String   @default("fixed")
  total          Decimal  @db.Decimal(15, 2) @default(0)
  totalTax       Decimal  @db.Decimal(15, 2) @default(0)
  remainingAmount Decimal @db.Decimal(15, 2) @default(0)
  appliedTotal   Decimal  @db.Decimal(15, 2) @default(0)
  clientNote     String?
  adminNote      String?
  hash           String   @unique @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id])
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  items          CreditNoteItem[]

  @@index([organizationId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String   @id @default(uuid())
  creditNoteId String
  description  String
  qty          Decimal  @db.Decimal(10, 2) @default(1)
  rate         Decimal  @db.Decimal(15, 2) @default(0)
  tax1         String?
  tax2         String?
  order        Int      @default(0)

  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_items")
}

// ═══════════════════════════════════════════════════════════════
