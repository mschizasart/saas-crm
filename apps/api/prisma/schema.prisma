// ═══════════════════════════════════════════════════════════════
//  PRODUCTS / INVENTORY
// ═══════════════════════════════════════════════════════════════

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sku            String?
  unitPrice      Decimal  @db.Decimal(15, 2)
  costPrice      Decimal? @db.Decimal(15, 2)
  taxRate        Decimal  @db.Decimal(5, 2) @default(0)
  unit           String?
  stockQuantity  Int      @default(0)
  lowStockAlert  Int      @default(5)
  trackInventory Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      StockMovement[]
  invoiceItems   InvoiceItem[]
  estimateItems  EstimateItem[]
  proposalItems  ProposalItem[]
  // CPQ (Wave F2 — migration 034)
  bundleItems    BundleItem[]
  quoteLineItems QuoteLineItem[]

  @@index([organizationId])
  @@map("products")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  // Positive for increases, negative for decreases
  delta          Int
  // Stock level AFTER this movement (audit trail)
  balanceAfter   Int
  reason         String   // "invoice_sent" | "manual_adjustment" | "return" | "purchase" | "correction"
  // Optional refs
  invoiceId      String?
  creditNoteId   String?
  userId         String?
  note           String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

// ═══════════════════════════════════════════════════════════════
//  INBOX (generic IMAP sync) — v1, INBOUND only.
//  Outbound mail flows through EmailsService / nodemailer; we
//  record only its Message-ID in OutboundMessage so the inbox
//  router can thread inbound replies back to the originating record.
// ═══════════════════════════════════════════════════════════════

model InboxMessage {
  id               String   @id @default(uuid())
  organizationId   String
  // RFC822 Message-ID (incl. angle brackets) — used for dedup + threading.
  messageId        String
  inReplyTo        String?
  referenceIds     String[] @default([])
  fromEmail        String
  fromName         String?
  toEmails         String[] @default([])
  ccEmails         String[] @default([])
  subject          String?
  bodyText         String?
  bodyHtml         String?
  receivedAt       DateTime
  attachmentCount  Int      @default(0)
  // [{filename, contentType, size}] — bodies are NOT fetched in v1.
  attachmentsJson  Json     @default("[]")
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'ticket' | 'unmatched'
  routedTo         String   @default("unmatched")
  routedToId       String?
  isRead           Boolean  @default(false)
  isStarred        Boolean  @default(false)
  isArchived       Boolean  @default(false)
  rawHeadersJson   Json     @default("{}")
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, messageId])
  @@index([organizationId, routedTo, routedToId])
  @@index([organizationId, isArchived, receivedAt(sort: Desc)])
  @@map("inbox_messages")
}

model OutboundMessage {
  id               String    @id @default(uuid())
  organizationId   String
  // RFC822 Message-ID returned by nodemailer. Nullable because the row is
  // created BEFORE send (so we have a trackingId to embed in the HTML).
  messageId        String?
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'ticket' | 'proposal' | 'statement'
  routedTo         String
  routedToId       String
  subject          String?
  // Denormalised recipient email — useful for the "Sent emails" panel.
  recipientEmail   String?
  // ── Open / click tracking (migration 011) ─────────────────────────────
  trackingId       String?   @unique
  openedAt         DateTime?
  openCount        Int       @default(0)
  lastOpenedAt     DateTime?
  clickedAt        DateTime?
  clickCount       Int       @default(0)
  lastClickedAt    DateTime?
  /// JSONB: array of { url, at, ip, userAgent }; capped at 50 entries
  /// by the application to prevent runaway growth.
  clickedUrls      Json      @default("[]")
  sentAt           DateTime  @default(now())
  createdAt        DateTime  @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, messageId])
  @@index([organizationId, routedTo, routedToId])
  @@map("outbound_messages")
}

// ═══════════════════════════════════════════════════════════════
//  BULK EMAIL CAMPAIGNS / NEWSLETTERS  (migration 024)
// ═══════════════════════════════════════════════════════════════
//
// A Campaign targets a recipient *segment* (segmentType + segmentConfig).
// The segment is resolved to concrete CampaignRecipient rows at send time
// (dedup by email, unsubscribed addresses skipped). Sending runs off the
// HTTP path via the BullMQ 'campaigns' queue and reuses EmailsService.queue()
// with tracking { routedTo: 'campaign', routedToId: campaign.id } so opens /
// clicks attribute back through OutboundMessage.

model Campaign {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  subject          String
  /// HTML body — unsubscribe link + tracking pixel injected at send time.
  body             String    @default("")
  /// 'draft' | 'scheduled' | 'sending' | 'sent' | 'failed'
  status           String    @default("draft")
  /// 'all_clients' | 'all_leads' | 'lead_status' | 'manual'
  segmentType      String    @default("all_clients")
  /// e.g. { statusId } for lead_status, { ids: [...] } for manual select.
  segmentConfig    Json      @default("{}")
  scheduledAt      DateTime?
  sentAt           DateTime?
  totalRecipients  Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients       CampaignRecipient[]

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String    @id @default(uuid())
  campaignId        String
  organizationId    String
  email             String
  name              String?
  /// 'client' | 'lead'
  recipientType     String
  /// Client.id / Lead.id (or contact User.id). Nullable for free-typed addrs.
  recipientId       String?
  /// 'pending' | 'sent' | 'failed' | 'skipped'
  status            String    @default("pending")
  /// FK-by-id (not a relation) to the OutboundMessage tracking row, so the
  /// stats endpoint can join opens/clicks back to this recipient.
  outboundMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  campaign          Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// Per-org suppression list. An email present here is SKIPPED when building
// campaign recipients. Populated via the public unsubscribe endpoint
// (HMAC-signed token). CAN-SPAM / GDPR table-stakes.
model EmailUnsubscribe {
  id               String    @id @default(uuid())
  organizationId   String
  email            String
  campaignId       String?
  createdAt        DateTime  @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("email_unsubscribes")
}

// ═══════════════════════════════════════════════════════════════
//  CROSS-RECORD SEARCH INDEX  (migration 012)
// ═══════════════════════════════════════════════════════════════
//
// Denormalised search rows — one per indexed business record across
// 8 entity types (lead | client | invoice | estimate | proposal |
// contract | ticket | product). Powers the Cmd-K palette and the
// /api/v1/search endpoint via Postgres FTS + pg_trgm.
//
// The actual `tsv` (tsvector) column is a STORED generated column
// added in 012-fts.sql — NOT modeled here, because Prisma has no
// first-class support for `GENERATED ALWAYS AS (...) STORED`. The
// indexer service writes only title/subtitle/body/url and Postgres
// keeps `tsv` in sync automatically.
model SearchIndex {
  id              String   @id @default(uuid())
  organizationId  String
  // 'lead' | 'client' | 'invoice' | 'estimate' | 'proposal' | 'contract' | 'ticket' | 'product'
  entityType      String
  entityId        String
  // Primary display string — invoice number, client company, lead name, etc.
  title           String
  // Secondary line — e.g. "Invoice · Acme Ltd · $1,200 · paid"
  subtitle        String?
  // Long-form text concatenated for FTS (description, notes, line items, etc.)
  body            String?
  // Canonical relative URL the palette navigates to (e.g. /invoices/:id).
  url             String
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId])
  @@index([organizationId, entityType])
  @@map("search_index")
}

// ─────────────────────────────────────────────────────────────────────
//  Web push subscriptions (migration 014)
//
//  One row per (browser, user) pair. The endpoint is the URL handed to
//  us by the browser's PushManager.subscribe() — it's globally unique
//  because the push service issues a different one for each device.
//
//  When web-push delivers a 410 Gone the application deletes the row;
//  the browser revoked it (cleared site data, denied permission, etc.).
// ─────────────────────────────────────────────────────────────────────
model PushSubscription {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // The endpoint URL is what we POST to when sending a push. Globally
  // unique — duplicate subscribe() calls return the same value, so we
  // upsert by endpoint.
  endpoint       String
  // Public key the user agent generated for this subscription.
  p256dh         String
  // Authentication secret (also generated by the user agent).
  auth           String
  userAgent      String   @default("")
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@index([organizationId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════
//  DOCUMENT STORAGE (polymorphic, versioned)
// ═══════════════════════════════════════════════════════════════
//
// A `Document` is a logical file attached to any record (client,
// invoice, estimate, project, ticket, lead). It is polymorphic on
// (entityType, entityId) — no FK, because the parent is one of many
// tables; the service layer validates the entity exists in the org.
//
// Each upload of a new revision creates a `DocumentVersion` row with a
// monotonically-increasing 1-based `version` number. The bytes live in
// MinIO (see StorageService); the DB only holds metadata + the object
// key. `Document.currentVersionId` points at the latest version.
model Document {
  id               String   @id @default(uuid())
  organizationId   String
  entityType       String   // 'client' | 'invoice' | 'estimate' | 'project' | 'ticket' | 'lead'
  entityId         String   // polymorphic — no FK
  name             String   // display filename
  currentVersionId String?  // points at the latest DocumentVersion
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  organizationId String
  version        Int      // 1-based
  storageKey     String   // MinIO object key
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedById   String?
  note           String?  // version comment
  createdAt      DateTime @default(now())

  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ═══════════════════════════════════════════════════════════════
//  DUNNING  (automated overdue-invoice reminders — migration 026)
// ═══════════════════════════════════════════════════════════════
//
// dunning_settings.enabled is the per-org master switch. dunning_rules
// are the ordered reminder steps (offsetDays relative to dueDate).
// dunning_logs is the idempotency + audit table — the
// @@unique([invoiceId, ruleId]) is the double-send guard (a given rule
// fires at most once per invoice, even across concurrent scheduler runs).
// See dunning.service.ts for the insert-then-send ordering.

model DunningSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("dunning_settings")
}

model DunningRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // Days relative to the invoice due date. Negative = before due,
  // positive = after due (e.g. -3, +1, +7, +14).
  offsetDays     Int
  subject        String
  // HTML body. Supports {{invoice_number}} {{amount}} {{due_date}}
  // {{client_name}} placeholders, interpolated by dunning.service.ts.
  body           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dunningLogs    DunningLog[]

  @@index([organizationId, isActive])
  @@map("dunning_rules")
}

model DunningLog {
  id                String   @id @default(uuid())
  organizationId    String
  invoiceId         String
  ruleId            String
  sentAt            DateTime @default(now())
  recipientEmail    String
  outboundMessageId String?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice           Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rule              DunningRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Double-send guard: a rule fires at most once per invoice.
  @@unique([invoiceId, ruleId])
  @@index([organizationId, sentAt])
  @@map("dunning_logs")
}

// ═══════════════════════════════════════════════════════════════
//  OPPORTUNITIES  (deal pipeline + weighted forecast — migration 027)
// ═══════════════════════════════════════════════════════════════
//
// Salesforce-style deal pipeline. Per-org configurable `OpportunityStage`
// rows form an ordered Kanban (Prospecting → Qualified → … → Closed
// Won/Lost). Each `Opportunity` carries an amount + closeDate; the
// weighted forecast is sum(amount * stage.probability / 100) over open
// deals (rows whose stage has isWon = isLost = false).
//
// `OpportunityStageHistory` records every transition for audit /
// velocity reporting. The service writes the history row and the
// opportunity update in a single prisma.$transaction so the two
// can never diverge.
//
// Tenant isolation: service layer (prisma.withOrganization). No RLS.

model OpportunityStage {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // Display order in the Kanban (1-based by convention).
  order          Int      @default(0) @map("order")
  // 0.00 … 100.00 — weight used by the forecast endpoint.
  probability    Decimal  @default(0) @db.Decimal(5, 2)
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz()

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]

  // Match the SQL unique index — required for the seed/backfill upsert
  // path and prevents duplicate stage names per org.
  @@unique([organizationId, name], map: "opportunity_stages_org_name_key")
  @@index([organizationId, order], map: "opportunity_stages_org_order_idx")
  @@map("opportunity_stages")
}

model Opportunity {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // A deal can be linked to either a Client (existing customer) or a
  // Lead (still being qualified), or neither (pure prospecting).
  clientId       String?
  leadId         String?
  ownerId        String
  stageId        String
  amount         Decimal  @default(0) @db.Decimal(15, 2)
  currency       String   @default("USD")
  closeDate      DateTime @db.Date
  description    String?
  source         String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner          User                      @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stage          OpportunityStage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageHistory   OpportunityStageHistory[]
  // CPQ (Wave F2 — migration 034)
  quotes         Quote[]
  // Field Service (Wave H1 — migration 039)
  workOrders     WorkOrder[] @relation("OpportunityWorkOrders")

  @@index([organizationId, stageId], map: "opportunities_org_stage_idx")
  @@index([organizationId, ownerId], map: "opportunities_org_owner_idx")
  @@index([organizationId, closeDate], map: "opportunities_org_close_date_idx")
  @@map("opportunities")
}

model OpportunityStageHistory {
  id             String   @id @default(uuid())
  organizationId String
  opportunityId  String
  // Null on the very first row (the create itself).
  fromStageId    String?
  toStageId      String
  changedById    String
  changedAt      DateTime @default(now()) @db.Timestamptz()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedBy      User         @relation("OpportunityStageHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([opportunityId, changedAt(sort: Desc)], map: "opportunity_stage_history_opp_idx")
  @@index([organizationId], map: "opportunity_stage_history_org_idx")
  @@map("opportunity_stage_history")
}

// ═══════════════════════════════════════════════════════════════
//  CUSTOM OBJECTS  (Wave D3 — migration 029)
// ═══════════════════════════════════════════════════════════════
//
// Tenants define their own entity types at runtime. NOT stored as
// real Postgres tables (too dangerous to expose to tenants) — every
// record is a row in `custom_records` with a `data` jsonb column keyed
// by field.key. Validation happens in the API layer against
// `custom_object_fields`. A GIN index on `data` covers basic jsonb
// queries; per-field text search falls back to ILIKE on `data->>'key'`.
//
// `slug` is per-org unique (two orgs may use the same slug). Reserved
// slugs and snake_case rules are enforced in custom-objects/validation.ts
// — see RESERVED_SLUGS and validateSlug() there.

model CustomObject {
  id             String   @id @default(uuid())
  organizationId String
  name           String   // e.g. "Vehicle"
  slug           String   // e.g. "vehicle" (lowercase snake_case)
  pluralName     String   // e.g. "Vehicles"
  icon           String?  // lucide-react icon name (nullable)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fields  CustomObjectField[]
  records CustomRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("custom_objects")
}

model CustomObjectField {
  id             String   @id @default(uuid())
  organizationId String
  customObjectId String
  label          String
  key            String   // snake_case, unique within the object
  // One of: 'text' | 'number' | 'date' | 'boolean' | 'select' | 'relation'
  fieldType      String
  // Per-type config:
  //   select   → { "choices": ["A","B","C"] }
  //   relation → { "relatedEntity": "clients" | "leads" | … }
  options        Json     @default("{}")
  required       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  customObject CustomObject @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  @@unique([customObjectId, key])
  @@index([customObjectId, order])
  @@map("custom_object_fields")
}

model CustomRecord {
  id             String   @id @default(uuid())
  organizationId String
  customObjectId String
  // Keyed by field.key. Validated/stripped against the object's field
  // defs in custom-records.service.ts before insert/update.
  data           Json     @default("{}")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customObject CustomObject @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  @@index([organizationId, customObjectId])
  @@map("custom_records")
}

// ─── Reports & Dashboards builder (migration 028, Wave D2) ────────────
// Saved report definitions executed by the whitelisted safe query
// builder in apps/api/src/modules/reports/report-engine.ts. Tenant
// isolation is enforced at the service layer; no Organization
// back-relation is declared here (same pattern as CustomObject above)
// to keep this slice self-contained.

model Report {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // Whitelisted key into report-engine.ts ENTITY_REGISTRY
  // (e.g. "clients", "leads", "invoices", "opportunities", "tickets", "tasks").
  entityType     String
  // JSONB array of { field, op, value } — validated by the engine.
  filters        Json     @default("[]")
  // Optional field name to group by.
  groupBy        String?
  // JSONB array of { fn, field } where fn in count|sum|avg|min|max.
  aggregations   Json     @default("[]")
  // table | bar | line | pie — also CHECK-constrained in SQL.
  chartType      String   @default("table")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  widgets        DashboardWidget[]

  @@index([organizationId, entityType])
  @@index([organizationId])
  @@map("reports")
}

model Dashboard {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // Optional global layout hints (forward-compat with react-grid-layout).
  layout         Json     @default("[]")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  widgets        DashboardWidget[]

  @@index([organizationId])
  @@map("dashboards")
}

model DashboardWidget {
  id             String   @id @default(uuid())
  organizationId String
  dashboardId    String
  reportId       String
  title          String?
  // {x:number, y:number, w:number, h:number} — shape validated server-side.
  position       Json     @default("{\"x\":0,\"y\":0,\"w\":6,\"h\":4}")
  createdAt      DateTime @default(now())

  dashboard      Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, dashboardId])
  @@index([reportId])
  @@map("dashboard_widgets")
}

// ─── Field history / audit trail (migration 031, Wave E2) ────────────
// Salesforce-style row-level change tracking for Client/Lead/Opportunity/
// Invoice/Ticket. Rows are written by the Prisma client extension at
// apps/api/src/modules/audit/audit-extension.ts — never by entity services
// directly. Tenant isolation is enforced in audit.service.ts (every read
// filters by organizationId) and in the extension (writes only happen when
// the AsyncLocalStorage AuditContext carries a non-null orgId).
//
// Tenant isolation is enforced at the service layer; no Organization
// back-relation is declared here (same pattern as Report/CustomObject
// above) to keep this slice self-contained.

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  // Prisma model name lowercase: 'client' | 'lead' | 'opportunity' |
  // 'invoice' | 'ticket'. Kept as a free-form text column so adding
  // more audited models doesn't require a schema migration.
  entityType     String
  entityId       String
  // 'create' | 'update' | 'delete' — also CHECK-constrained in SQL.
  action         String
  // Update: { field: { from, to }, ... }
  // Create: { _all: { ...scalar snapshot } }
  // Delete: { _all: { ...scalar snapshot } }
  // Capped at ~10KB by the extension (values truncated to '[truncated]').
  changes        Json     @default("{}")
  changedById    String?
  ip             String?
  changedAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId, changedAt])
  @@index([organizationId, changedAt])
  @@index([organizationId, changedById, changedAt])
  @@map("audit_log")
}

// ─── Approval Workflows (migration 030, Wave E1) ──────────────────────
// Multi-step approval chains. Tenants define `ApprovalProcess` rows
// (one per gated entity type) with an ordered list of `ApprovalStep`s.
// A live `ApprovalRequest` advances through steps as eligible approvers
// post `ApprovalDecision` rows. Tenant isolation is enforced at the
// service layer with explicit `where: { organizationId: orgId }` on
// every read AND write; no Organization back-relation declared here
// (same pattern as Report / Dashboard above) to keep this slice
// self-contained and avoid touching existing models.

model ApprovalProcess {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  // 'invoice' | 'opportunity' | 'expense' | 'custom' — CHECK constraint
  // in 030-approvals.sql enforces the enum at the DB.
  entityType       String
  active           Boolean  @default(true)
  // {field, op, value} — when to require approval. Empty object = always.
  // The calling subsystem (e.g. invoices.service) evaluates this BEFORE
  // creating a request.
  triggerCondition Json     @default("{}")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  steps            ApprovalStep[]
  requests         ApprovalRequest[]

  @@index([organizationId])
  @@index([organizationId, entityType])
  @@map("approval_processes")
}

model ApprovalStep {
  id              String   @id @default(uuid())
  organizationId  String
  processId       String
  order           Int
  // 'user' | 'role' | 'manager' — also CHECK-constrained in SQL.
  // 'manager' is reserved for future use (resolved at decide-time from
  // the requester's reports-to chain; not implemented yet — see TODO
  // in approval-requests.service.ts).
  approverType    String
  approverUserId  String?
  approverRoleId  String?
  name            String?
  createdAt       DateTime @default(now())

  process         ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([processId, order])
  @@map("approval_steps")
}

model ApprovalRequest {
  id                String   @id @default(uuid())
  organizationId    String
  processId         String
  targetType        String
  targetId          String
  // 'pending' | 'approved' | 'rejected' | 'cancelled' — CHECK in SQL.
  status            String   @default("pending")
  // The ORDER (not id) of the step currently awaiting a decision.
  // Updated atomically with the decision insert inside ONE $transaction
  // so the request can never "skip" a step.
  currentStepOrder  Int      @default(0)
  requestedById     String
  startedAt         DateTime @default(now())
  completedAt       DateTime?

  process           ApprovalProcess    @relation(fields: [processId], references: [id])
  decisions         ApprovalDecision[]

  @@index([organizationId, status])
  @@index([organizationId, targetType, targetId])
  @@index([organizationId, requestedById])
  @@map("approval_requests")
}

model ApprovalDecision {
  id              String   @id @default(uuid())
  organizationId  String
  requestId       String
  stepOrder       Int
  decidedById     String
  // 'approve' | 'reject' — CHECK in SQL.
  decision        String
  comment         String?
  decidedAt       DateTime @default(now())

  request         ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepOrder], name: "approval_decisions_request_step_uniq")
  @@index([requestId, decidedAt])
  @@index([organizationId, decidedById])
  @@map("approval_decisions")
}

// ─── Public REST API + Webhooks (migration 032, Wave E3) ──────────────
// Tables named `public_*` so the legacy in-app `ApiKey` / `Webhook` models
// above remain untouched and keep powering the in-app console pages
// (`/settings/api-keys`, `/settings/webhooks`). These NEW models back the
// public REST API surface (`/settings/api`) with scoped keys, HMAC-signed
// outbound deliveries, retries with back-off, and an audit trail.
//
// Tenant isolation: every read AND write goes through the service layer
// with `where: { organizationId: orgId }` — no RLS here.

model PublicApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  // First 8 chars after the `crm_` prefix; plaintext, indexed for lookup
  // before the constant-time hash compare. NOT a secret on its own.
  keyPrefix      String
  // sha256(full_key) hex — the secret part of the key is NEVER stored.
  keyHash        String
  // ['clients.read','invoices.write', ...] — checked by the strategy at
  // request time (see api-key.strategy.ts). Empty array == no scopes
  // (caller can only hit endpoints that don't require a scope).
  scopes         Json      @default("[]")
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  // Soft delete — preserves audit / delivery attribution. NULL == active.
  revokedAt      DateTime?

  @@unique([organizationId, keyPrefix])
  @@index([keyPrefix])
  @@map("public_api_keys")
}

model PublicWebhook {
  id             String    @id @default(uuid())
  organizationId String
  // Validated to start with `https://` at the DTO layer.
  url            String
  // ['client.created','invoice.paid',…] — must be a subset of ALLOWED_EVENTS
  // (see webhook-events.ts). Enforced at the service layer on write.
  events         Json      @default("[]")
  // 32-byte hex secret; stored encrypted at-rest (envelope-compatible with
  // email_settings.smtpPassword via the common/crypto/encrypt.ts helper).
  // Decrypted only inside webhook-delivery.processor.ts at HMAC sign time.
  secret         String
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveries     PublicWebhookDelivery[]

  @@index([organizationId, active])
  @@map("public_webhooks")
}

model PublicWebhookDelivery {
  id             String    @id @default(uuid())
  organizationId String
  webhookId      String
  event          String
  payload        Json      @default("{}")
  statusCode     Int?
  responseBody   String?
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  // Driven by the back-off schedule in webhook-delivery.processor.ts:
  // attempt 1→+1m, 2→+5m, 3→+30m, 4→+2h, 5→+12h. NULL after permanent fail.
  nextAttemptAt  DateTime?
  succeeded      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  webhook        PublicWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, webhookId, createdAt(sort: Desc)])
  @@index([succeeded, nextAttemptAt])
  @@map("public_webhook_deliveries")
}

// ═══════════════════════════════════════════════════════════════
//  CPQ — Configure-Price-Quote (Wave F2 — migration 034)
//
//  Salesforce-style quoting:
//    * ProductBundle / BundleItem — admin-curated kits of products
//      with a per-item discount. Bundles can be dropped onto a quote
//      as a single line.
//    * Quote / QuoteLineItem — the quote header + lines. Each line
//      is EITHER a Product OR a Bundle (XOR enforced in service AND
//      a DB CHECK in 034-cpq.sql).
//
//  Status flow: draft → sent → accepted | rejected. `expired` is set
//  by the `expire-quotes` cron once `validUntil` passes (TODO Wave F2.1).
//
//  Numbering: per-org sequence — service generates `Q-YYYY-NNNN`,
//  uniqueness enforced via @@unique([organizationId, number]).
// ═══════════════════════════════════════════════════════════════

model ProductBundle {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("ProductBundleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          BundleItem[]
  // Back-relation for QuoteLineItem.bundleId (SET NULL on bundle delete —
  // accepted quotes keep their frozen unitPrice/lineTotal).
  quoteLineItems QuoteLineItem[]

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("product_bundles")
}

model BundleItem {
  id              String  @id @default(uuid())
  organizationId  String
  bundleId        String
  productId       String
  quantity        Int     @default(1)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  order           Int     @default(0)

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bundle          ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, bundleId])
  @@index([productId])
  @@map("bundle_items")
}

model Quote {
  id                  String    @id @default(uuid())
  organizationId      String
  number              String
  clientId            String
  opportunityId       String?
  // 'draft' | 'sent' | 'accepted' | 'rejected' | 'expired'
  status              String    @default("draft")
  validUntil          DateTime? @db.Date
  subtotal            Decimal   @default(0) @db.Decimal(15, 2)
  discountPercent     Decimal   @default(0) @db.Decimal(5, 2)
  total               Decimal   @default(0) @db.Decimal(15, 2)
  currency            String    @default("USD")
  notes               String?
  sentAt              DateTime? @db.Timestamptz()
  acceptedAt          DateTime? @db.Timestamptz()
  // Populated when the quote is converted to an Invoice — used as the
  // "already converted" guard (idempotency).
  convertedInvoiceId  String?
  createdById         String?
  createdAt           DateTime  @default(now()) @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @db.Timestamptz()

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunity         Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  convertedInvoice    Invoice?      @relation("QuoteConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  createdBy           User?         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems           QuoteLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, opportunityId])
  @@map("quotes")
}

model QuoteLineItem {
  id              String  @id @default(uuid())
  organizationId  String
  quoteId         String
  // XOR — exactly one of productId / bundleId is set. Enforced in the
  // service AND by a DB CHECK constraint in 034-cpq.sql.
  productId       String?
  bundleId        String?
  description     String?
  quantity        Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @default(0) @db.Decimal(15, 2)
  order           Int     @default(0)

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  bundle          ProductBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([organizationId, quoteId])
  @@index([productId])
  @@index([bundleId])
  @@map("quote_line_items")
}

// ═══════════════════════════════════════════════════════════════
//  WAVE F3 — MULTI-CURRENCY + DAILY FX RATES (migration 035)
//
//  `FxCurrency` is a GLOBAL ISO-4217 reference table — no
//  `organizationId`, the same for every tenant. Distinct from
//  the legacy per-org `Currency` model above (which stores
//  formatting + a fixed `exchangeRate` per org). We picked the
//  `FxCurrency` name to avoid a collision with `Currency`.
//
//  `ExchangeRate` is PER-ORG so admins can manually override
//  any ECB-pulled rate without polluting other tenants. One row
//  per (org, from, to, date, source). See FxService.getRate()
//  for lookup ordering (manual > ecb > inverse > EUR cross).
// ═══════════════════════════════════════════════════════════════

model FxCurrency {
  code           String  @id              // ISO 4217, e.g. 'USD'
  name           String
  symbol         String
  decimalPlaces  Int     @default(2)

  @@map("fx_currencies")
}

model ExchangeRate {
  id              String   @id @default(uuid())
  organizationId  String
  fromCurrency    String
  toCurrency      String
  // Wide precision so EUR→KRW or similar high-magnitude pairs
  // (≈ 1400 KRW per EUR) stay loss-free.
  rate            Decimal  @db.Decimal(20, 10)
  date            DateTime @db.Date
  // 'manual' | 'ecb' | 'openexchange' — enforced by a CHECK
  // constraint in 035-multi-currency.sql.
  source          String   @default("ecb")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, fromCurrency, toCurrency, date, source], map: "exchange_rates_org_pair_date_source_uniq")
  @@index([organizationId, fromCurrency, toCurrency, date(sort: Desc)], map: "exchange_rates_org_pair_date_idx")
  @@map("exchange_rates")
}

// ═══════════════════════════════════════════════════════════════
//  Territories (Wave G2 — migration 037)
//
//  Sales orgs partition their book of business by geography,
//  industry, or product line. Each tenant defines territories
//  (optionally arranged into a parent/child hierarchy),
//  assigns users as members or managers, and routes Clients /
//  Leads / Opportunities to specific territories.
//
//  Tenant isolation is enforced at the service layer — every read
//  AND write goes through `where: { organizationId: orgId }`. No
//  Organization / User / Client back-relations are declared here
//  so this slice stays self-contained (same pattern as Approval /
//  Audit / Custom Objects above). Cross-tenant FK guards on every
//  user-supplied id at the service layer.
// ═══════════════════════════════════════════════════════════════

model Territory {
  id                  String   @id @default(uuid())
  organizationId      String
  name                String
  description         String?
  // Self-FK for the territory tree. NULL == root.
  parentTerritoryId   String?
  parent              Territory?  @relation("TerritoryHierarchy", fields: [parentTerritoryId], references: [id], onDelete: SetNull)
  children            Territory[] @relation("TerritoryHierarchy")
  // Designated manager — the single routing pointer. Multiple
  // members may carry `role='manager'` in territory_members for
  // elevated visibility without changing this routing pointer.
  managerId           String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  members             TerritoryMember[]
  assignments         TerritoryAssignment[]

  @@unique([organizationId, name], map: "territories_org_name_uniq")
  @@index([organizationId, parentTerritoryId], map: "territories_org_parent_idx")
  @@index([organizationId], map: "territories_org_idx")
  @@map("territories")
}

model TerritoryMember {
  id              String   @id @default(uuid())
  organizationId  String
  territoryId     String
  userId          String
  // 'member' | 'manager' — enforced by SQL CHECK constraint.
  role            String   @default("member")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  territory       Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, userId], map: "territory_members_territory_user_uniq")
  @@index([organizationId, territoryId, userId], map: "territory_members_org_territory_user_idx")
  @@index([organizationId, userId], map: "territory_members_org_user_idx")
  @@map("territory_members")
}

model TerritoryAssignment {
  id              String   @id @default(uuid())
  organizationId  String
  territoryId     String
  // Polymorphic — 'client' | 'lead' | 'opportunity' (CHECK in SQL).
  // No DB-level FK on entityId; the service layer validates that
  // the entity exists in the right table for the caller's org
  // before insert (same pattern as audit_log).
  entityType      String
  entityId        String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  territory       Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, entityType, entityId], map: "territory_assignments_territory_entity_uniq")
  @@index([organizationId, entityType, entityId], map: "territory_assignments_org_entity_idx")
  @@index([organizationId, territoryId, entityType], map: "territory_assignments_org_territory_type_idx")
  @@map("territory_assignments")
}

// ═══════════════════════════════════════════════════════════════
//  CHATTER-STYLE INTERNAL FEED + @MENTIONS  (Wave G3 — migration 038)
//
//  Every record (Client / Lead / Opportunity / Ticket) has a feed
//  where teammates post notes, ask questions, and @mention each
//  other. Mentioned users get an in-app notification (and best-
//  effort web push) via the existing NotificationsService.
//
//  Polymorphic attach point is `entityType` + `entityId` — same
//  pattern as `territory_assignments` and `audit_log`. The
//  service layer cross-tenant-guards every entityId on write.
//
//  Threading is via a self-FK on `parentPostId`. Replies cascade
//  with the parent on hard delete, but the API path prefers
//  SOFT-delete (setting `deletedAt`) so threads stay readable
//  after a moderator removes a post.
//
//  `FeedMention` has a UNIQUE(post, user) so the notification
//  listener can't fire twice for the same mention even if the
//  caller submits dupes.
// ═══════════════════════════════════════════════════════════════

model FeedPost {
  id              String   @id @default(uuid())
  organizationId  String
  // Polymorphic — 'client' | 'lead' | 'opportunity' | 'ticket'.
  // CHECK constraint in 038-feed.sql; the service uses the same
  // enum in its switch to validate cross-tenant entity access
  // before insert.
  entityType      String
  entityId        String
  // Nullable so a removed author doesn't blow away the thread.
  // The UI renders "[former member]" when this is null. No formal
  // Prisma relation back to User — kept as a scalar (same pattern
  // as TerritoryMember.userId) to avoid touching the User model.
  // The DB-level FK to users(id) with ON DELETE SET NULL lives in
  // 038-feed.sql.
  authorId        String?
  body            String
  // Self-FK for threaded replies. The list endpoint returns only
  // top-level posts (parentPostId IS NULL) with their children
  // hydrated; arbitrary depth is allowed at the DB level.
  parentPostId    String?
  // Soft-delete: preserves thread structure when a post is
  // removed. UI renders deleted posts as "[deleted]" placeholders.
  deletedAt       DateTime? @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @db.Timestamptz()

  // Self-relation only — organisation / author are scalar-only on
  // purpose (see comment above). The DB-level FKs are in
  // 038-feed.sql and still cascade correctly on org/user delete.
  parentPost      FeedPost?     @relation("FeedPostThread", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies         FeedPost[]    @relation("FeedPostThread")
  mentions        FeedMention[]

  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)], map: "feed_posts_org_entity_created_idx")
  @@index([organizationId, parentPostId], map: "feed_posts_org_parent_idx")
  @@map("feed_posts")
}

model FeedMention {
  id               String    @id @default(uuid())
  organizationId   String
  postId           String
  // Scalar-only (no Prisma relation to User) — see FeedPost.authorId
  // comment. DB-level FK with ON DELETE CASCADE in 038-feed.sql.
  mentionedUserId  String
  // Stamped by the notification listener after the in-app
  // notification is delivered. NULL means "still pending" — lets
  // ops re-fire missed notifications by scanning for nulls.
  notifiedAt       DateTime? @db.Timestamptz()
  createdAt        DateTime  @default(now()) @db.Timestamptz()

  post             FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Belt-and-braces uniqueness — even a buggy caller can't make
  // the same user receive two notifications for one post.
  @@unique([postId, mentionedUserId], map: "feed_mentions_post_user_uniq")
  @@index([organizationId, mentionedUserId, createdAt(sort: Desc)], map: "feed_mentions_org_user_created_idx")
  @@map("feed_mentions")
}

// ═══════════════════════════════════════════════════════════════
//  EINSTEIN ACTIVITY CAPTURE (Wave H2 — migration 040)
// ═══════════════════════════════════════════════════════════════
//
// Salesforce-style unified customer-interaction timeline. Email
// and SMS sent / received are auto-logged here so reps stop
// having to manually log every touch. See
// `apps/api/src/modules/activity-capture/*` for the listeners
// that observe email.outbound.sent / email.inbound.received /
// sms.outbound.sent / sms.inbound.received and stamp these rows.
//
// Back-relations are intentionally NOT defined on the existing
// Organization model — following the Wave G2 / Wave G3 pattern
// of declaring polymorphic FK targets at the DB layer
// (migration 040) without touching existing models in
// schema.prisma. The application is the only tenancy boundary;
// every read/write must include `organizationId` in the WHERE.

model Activity {
  id             String   @id @default(uuid())
  organizationId String
  // 'email' | 'sms' | 'call' | 'note' | 'meeting'. v1 only writes
  // 'email' and 'sms' (the capture pipeline); 'call' / 'note' /
  // 'meeting' are reserved for the manual-log UI follow-up.
  type           String
  // 'email' | 'sms' | 'phone' | 'in_person' — null for note/meeting.
  channel        String?
  // 'inbound' | 'outbound' — null for note (not directional).
  direction      String?
  subject        String?
  // Body is truncated to 4000 chars at capture time so a giant
  // newsletter doesn't bloat the timeline row.
  body           String?
  // Polymorphic pin — matches the inbox/outbound message routing
  // taxonomy so a future "unified inbox" view can join across.
  relatedToType  String
  relatedToId    String
  // Optional secondary pin: the Contact (User type='contact') the
  // capture matched against. Lets the UI show both "John (Acme)
  // <john@acme.com>" AND "Acme Inc." for the same row.
  contactId      String?
  occurredAt     DateTime @default(now()) @db.Timestamptz()
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@index([organizationId, relatedToType, relatedToId, occurredAt(sort: Desc)], map: "activities_org_related_idx")
  @@index([organizationId, contactId, occurredAt(sort: Desc)], map: "activities_org_contact_idx")
  @@map("activities")
}

model ActivityCaptureSettings {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  emailCaptureEnabled    Boolean  @default(true)
  smsCaptureEnabled      Boolean  @default(true)
  // Default OFF — most tenants do NOT want internal staff↔staff
  // mail polluting customer timelines.
  captureInternalEmails  Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz()
  updatedAt              DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@map("activity_capture_settings")
}

model ActivityCaptureLog {
  id             String   @id @default(uuid())
  organizationId String
  // 'outbound_email' | 'inbound_email' | 'outbound_sms' | 'inbound_sms'
  sourceType     String
  // OutboundMessage.id | InboxMessage.id | SmsMessage.id — points
  // back at the row the capture pipeline observed.
  sourceId       String
  // null when no Activity was created (no match / disabled / internal).
  activityId     String?
  matched        Boolean  @default(false)
  // 'captured' | 'no_matching_contact' | 'disabled_by_settings'
  // | 'internal_email' | 'duplicate' — human-readable explanation
  // of what the pipeline decided. Kept as a free-form string so
  // we can introduce new reasons without a migration.
  reason         String
  createdAt      DateTime @default(now()) @db.Timestamptz()

  // Belt-and-braces dedup: even a buggy listener firing twice
  // (retry, replay, backfill rerun) can only produce ONE
  // Activity row. The second insert hits P2002 and the service
  // treats it as "already captured, skip".
  @@unique([sourceType, sourceId], map: "activity_capture_log_source_uniq")
  @@index([organizationId, sourceType], map: "activity_capture_log_org_source_idx")
  @@index([activityId], map: "activity_capture_log_activity_idx")
  @@map("activity_capture_log")
}

// ═══════════════════════════════════════════════════════════════
//  FIELD SERVICE — WORK ORDERS + DISPATCH  (Wave H1 — migration 039)
//
//  Service businesses (HVAC / IT / landscaping) dispatch
//  technicians to client sites. A WorkOrder ties together:
//    - the client + optional originating opportunity
//    - the assigned technician + scheduled window
//    - on-site work captured as line items (service or part).
//
//  Lifecycle:
//      draft → scheduled → in_progress → completed
//                                     ↓
//                                  cancelled (also from draft / scheduled)
//
//  The status machine is the single source of truth for what
//  transitions are legal (see ALLOWED_TRANSITIONS in
//  work-orders.service.ts). Every transition writes a
//  `WorkOrderStatusHistory` row inside the SAME `$transaction`
//  as the parent update — mirroring the
//  opportunity_stage_history pattern from Wave D so the audit
//  log can never drift from the live row.
//
//  Self-contained — no back-relations on Client / Opportunity /
//  Product / User beyond the User.isTechnician flag (which is
//  the assignability gate). DB-level FKs in 039-field-service.sql
//  still cascade correctly. Same self-contained pattern as
//  Territories (Wave G2) and Feed (Wave G3).
// ═══════════════════════════════════════════════════════════════

model WorkOrder {
  id               String   @id @default(uuid())
  organizationId   String
  // Per-org sequence "WO-YYYY-NNNN" — generated in
  // WorkOrdersService.generateWorkOrderNumber(). The
  // @@unique([organizationId, number]) catches concurrent
  // collisions as a P2002 the caller can retry.
  number           String
  clientId         String
  // Nullable — work orders can be created standalone (a one-off
  // service call) or rolled from an accepted opportunity.
  opportunityId    String?
  // Free-form site address; defaults populated by the create
  // form from the client record but kept independent because a
  // single client may have many service locations.
  locationAddress  String?
  scheduledStart   DateTime? @db.Timestamptz()
  scheduledEnd     DateTime? @db.Timestamptz()
  // 'draft' | 'scheduled' | 'in_progress' | 'completed' | 'cancelled'
  // CHECK constraint in 039-field-service.sql mirrors the
  // ALLOWED_TRANSITIONS map in the service.
  status           String   @default("draft")
  // Scalar-only FK to users(id) — the DB-level constraint with
  // ON DELETE SET NULL lives in 039-field-service.sql. The
  // service enforces assignment only against users where
  // `isTechnician = true`.
  technicianId     String?
  // 'low' | 'normal' | 'high' | 'urgent' — CHECK in SQL.
  priority         String   @default("normal")
  description      String?
  // Free-form notes written by the technician on completion
  // (e.g. "Replaced compressor; site clean on departure").
  completionNotes  String?
  createdById      String?
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @updatedAt @db.Timestamptz()
  // Lifecycle timestamps — stamped atomically with the status
  // transition by the dedicated start / complete / cancel
  // endpoints. Never written via the generic update.
  startedAt        DateTime? @db.Timestamptz()
  completedAt      DateTime? @db.Timestamptz()
  cancelledAt      DateTime? @db.Timestamptz()

  // Forward relations to existing entities. Back-relations are
  // declared on Client / Opportunity. Wave H1 smoke surfaced
  // that the service layer's `include: { client, opportunity }`
  // calls require these declarations.
  client           Client       @relation("ClientWorkOrders", fields: [clientId], references: [id], onDelete: Restrict)
  opportunity      Opportunity? @relation("OpportunityWorkOrders", fields: [opportunityId], references: [id], onDelete: SetNull)
  lineItems        WorkOrderLineItem[]
  statusHistory    WorkOrderStatusHistory[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, technicianId, scheduledStart])
  @@index([organizationId, clientId])
  @@index([organizationId, scheduledStart])
  @@map("work_orders")
}

model WorkOrderLineItem {
  id              String   @id @default(uuid())
  organizationId  String
  workOrderId     String
  // 'service' (labor / time) | 'part' (materials). CHECK in
  // SQL. Drives downstream billing categorisation if the line
  // is later flowed into an Invoice.
  type            String   @default("service")
  // Optional — free-form lines (custom labor descriptions) are
  // allowed for ad-hoc charges that aren't in the catalog.
  productId       String?
  description     String
  // NUMERIC(10,2) — fractional quantities (e.g. 1.5 hours of
  // labor) are explicit and allowed.
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @default(0) @db.Decimal(15, 2)
  // Server-computed (qty * unitPrice). The client never supplies
  // this — same hardening as the Quote module.
  lineTotal       Decimal  @default(0) @db.Decimal(15, 2)
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz()

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, workOrderId])
  @@map("work_order_line_items")
}

model WorkOrderStatusHistory {
  id              String   @id @default(uuid())
  organizationId  String
  workOrderId     String
  // NULL on the initial 'draft' insert row (mirroring the
  // opportunity_stage_history pattern where the create event is
  // logged with fromStageId = null).
  fromStatus      String?
  toStatus        String
  // Scalar-only FK to users(id); DB-level ON DELETE SET NULL
  // lives in 039-field-service.sql. A deleted user keeps the
  // history row intact so the audit trail stays readable.
  changedById     String?
  notes           String?
  changedAt       DateTime @default(now()) @db.Timestamptz()

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, workOrderId, changedAt(sort: Desc)])
  @@map("work_order_status_history")
}

// ═══════════════════════════════════════════════════════════════
//  BULK OPERATIONS AUDIT LOG  (Wave H3 — migration 041)
//
//  One row per bulk-create / bulk-update / bulk-delete / csv-import
//  request. Drives the "Bulk Imports" admin page (list + detail).
//
//  Scalar-only relations to organisations / users — the DB-level
//  FKs in 041-bulk-operations.sql still cascade on org delete and
//  set-null on user delete. We deliberately do NOT add a back-
//  relation on `Organization` / `User` here to keep the heavy
//  models lean (same pattern as TerritoryAssignment / FeedPost).
//
//  `errorsJson` caps at the first 50 per-row errors — the service
//  enforces the cap when it writes the row. Storing the full
//  failure list at 1000 rows per request would inflate the table
//  quickly and the detail page only ever surfaces a sample.
// ═══════════════════════════════════════════════════════════════

model BulkOperation {
  id              String    @id @default(uuid())
  organizationId  String
  // 'bulk_create' | 'bulk_update' | 'bulk_delete' | 'csv_import'
  // CHECK in 041-bulk-operations.sql.
  type            String
  // 'client' | 'lead' | 'opportunity' | 'task'
  // CHECK in 041-bulk-operations.sql.
  entityType      String
  totalRows       Int       @default(0)
  succeededRows   Int       @default(0)
  failedRows      Int       @default(0)
  // Sample of the first 50 row errors. Shape:
  //   [{ index: number, error: string }]
  // Kept as Json so the service can serialise without a join.
  errorsJson      Json      @default("[]")
  // 'processing' | 'completed' | 'failed'
  status          String    @default("processing")
  startedAt       DateTime  @default(now()) @db.Timestamptz()
  completedAt     DateTime? @db.Timestamptz()
  // Scalar-only FK to users(id); DB-level ON DELETE SET NULL is
  // declared in 041-bulk-operations.sql so a deleted user's
  // import history stays readable.
  createdById     String?

  @@index([organizationId, createdById, startedAt(sort: Desc)], map: "bulk_operations_org_user_started_idx")
  @@index([organizationId, entityType, startedAt(sort: Desc)], map: "bulk_operations_org_entity_started_idx")
  @@map("bulk_operations")
}
