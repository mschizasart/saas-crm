{
  "name": "saas-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "tsx test/runner/index.ts all",
    "test:all": "tsx test/runner/index.ts all",
    "test:unit": "tsx test/runner/index.ts unit",
    "test:integration": "tsx test/runner/index.ts integration",
    "test:component": "tsx test/runner/index.ts component",
    "test:e2e": "tsx test/runner/index.ts e2e",
    "test:smoke": "tsx test/runner/index.ts smoke",
    "test:security": "tsx test/runner/index.ts security",
    "test:contract": "tsx test/runner/index.ts contract",
    "test:migration": "tsx test/runner/index.ts migration",
    "test:performance": "tsx test/runner/index.ts performance",
    "test:stress": "tsx test/runner/index.ts stress",
    "test:mutation": "tsx test/runner/index.ts mutation",
    "test:visual": "pnpm --filter web exec playwright test --config=../../test/visual/playwright.config.ts",
    "test:watch": "tsx test/runner/index.ts watch",
    "test:dashboard": "tsx test/runner/index.ts dashboard",
    "test:list": "tsx test/runner/index.ts list",
    "test:turbo": "turbo run test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:generate": "pnpm --filter api prisma generate",
    "db:studio": "pnpm --filter api prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "chokidar": "^3.6.0",
    "autocannon": "^7.15.0",
    "pg": "^8.13.0",
    "zod": "^3.24.2",
    "vitest": "^2.1.8",
    "@types/autocannon": "^7.12.5",
    "@types/pg": "^8.11.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "puppeteer",
      "msgpackr-extract",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "overrides": {
      "glob": ">=10.4.5",
      "picomatch": ">=4.0.3",
      "@fastify/middie": ">=9.0.3",
      "fastify": ">=5.6.1",
      "axios": ">=1.15.1",
      "lodash": ">=4.17.21",
      "basic-ftp": ">=5.0.5"
    }
  }
}
